<#if failure><h1>Supplier documents</h1><p role="alert" class="error">${failure.message}</p><#if failure.kind == 'AuthenticationRequired'><p>Open the link the buyer sent you, or <a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath)}">sign in</a> with the account you were invited to.</p></#if>
<#else><h1>Supplier documents</h1>
<#if view.supplierName><p>${view.supplierName}</p></#if>
<section class="card" id="SupplierDocuments" aria-label="Documents"><h2>Requests and orders</h2>
<#if view.documentList.length><ul class="docs"><#list view.documentList as doc><li><p><strong>${doc.reference}</strong><#if doc.title> · ${doc.title}</#if></p><p>${doc.stateText}<#if doc.dueText> · <#if doc.kind == 'quote'>respond by<#else>delivery by</#if> ${doc.dueText}</#if></p><p><a href="${passBases.supplier}${doc.path}">${doc.actionText}</a></p></li></#list></ul>
<#else><p>Nothing to answer from ${view.contact.organizationName} right now.</p></#if></section>
<#if view.billList.length><section class="card" aria-label="Bills sent"><h2>Bills sent</h2><ul class="docs"><#list view.billList as bill><li><a href="${passBases.supplier}${bill.path}">${bill.referenceNumber}</a> · order ${bill.orderId} · ${bill.receivedDateText}</li></#list></ul></section></#if>
<section class="card" id="SupplierContact" aria-label="Contact"><h2>Contact</h2><dl><dt>Buyer</dt><dd>${view.contact.organizationName}</dd><#if view.contact.emailAddress><dt>Email</dt><dd class="wrap"><a href="mailto:${view.contact.emailAddress}">${view.contact.emailAddress}</a></dd></#if><#if view.contact.expiresText><dt>This link works until</dt><dd>${view.contact.expiresText}</dd></#if></dl></section></#if>
