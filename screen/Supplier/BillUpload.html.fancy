<#if failure><h1>Bill upload</h1><p role="alert" class="error">${failure.message}</p><#if failure.kind == 'AuthenticationRequired'><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath)}">Sign in</a></p></#if>
<#else><h1>Bill for order ${view.order.orderId}</h1>
<#if billError><p role="alert" class="error">${billError}</p></#if>
<section class="card" aria-label="Order"><dl><#if view.order.orderName><dt>Order</dt><dd>${view.order.orderName}</dd></#if><#if view.order.placedDateText><dt>Placed</dt><dd>${view.order.placedDateText}</dd></#if><#if view.order.totalText><dt>Order total</dt><dd>${view.order.totalText}</dd></#if></dl></section>
<#if view.submission><section class="card" id="SubmissionReceipt" aria-live="polite"><h2>Bill received</h2><dl><dt>Your bill number</dt><dd>${view.submission.referenceNumber}</dd><dt>Received</dt><dd>${view.submission.receivedDateText}</dd><dt>Our reference</dt><dd>${view.submission.billReference}</dd><dt>File</dt><dd class="wrap">${view.submission.filename}</dd><dt>Status</dt><dd>${view.submission.stateText}</dd></dl><p><a href="?<#if token>token=${encodeURIComponent(token)}<#else>orderId=${encodeURIComponent(view.order.orderId)}</#if>">Send another bill for this order</a></p></section></#if>
<#if view.submissionList.length && !view.submission><section class="card" aria-label="Bills sent"><h2>Bills sent for this order</h2><#list view.submissionList as row><p>${row.referenceNumber} · ${row.receivedDateText} · ${row.stateText}</p></#list></section></#if></#if>
