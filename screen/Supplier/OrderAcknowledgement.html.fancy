<#if failure><h1>Purchase order</h1><p role="alert" class="error">${failure.message}</p><#if failure.kind == 'AuthenticationRequired'><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath)}">Sign in</a></p></#if>
<#elseif view.superseded><h1>Purchase order ${view.superseded.orderId}</h1><p role="alert" class="error" id="SupersededRevision">${view.superseded.message}</p><p><a href="${billPath}">Send a bill for this order</a></p>
<#else><#assign o = view.order><h1>Purchase order ${o.orderId}</h1>
<#if orderError><p role="alert" class="error">${orderError}</p></#if><#if orderNotice><p role="status">${orderNotice}</p></#if>
<section class="card" id="PublishedPurchaseOrder" aria-label="Order"><p><strong>${o.buyerName}</strong> orders from ${o.supplierName}<#if o.orderName>: ${o.orderName}</#if></p>
<dl><dt>Revision</dt><dd>${o.revisionText}</dd><#if o.placedText><dt>Placed</dt><dd>${o.placedText}</dd></#if><#if o.deliveryText><dt>Delivery by</dt><dd>${o.deliveryText}</dd></#if><#if o.paymentTermText><dt>Payment terms</dt><dd>${o.paymentTermText}</dd></#if><#if o.incotermText><dt>Incoterm</dt><dd>${o.incotermText}</dd></#if><#if o.shipToName || o.shipToAddress><dt>${o.dropShip ? 'Ship to the customer' : 'Deliver to'}</dt><dd class="wrap">${o.shipToName || ''}<#if o.shipToAddress><br>${o.shipToAddress}</#if></dd></#if><#if o.totalText><dt>Order total</dt><dd>${o.totalText}</dd></#if><dt>Status</dt><dd>${o.statusText}</dd></dl>
<div class="table-wrap"><table class="lines"><caption>Lines</caption><thead><tr><th scope="col">Line</th><th scope="col">Item</th><th scope="col">Qty</th><th scope="col">Price</th><th scope="col">Amount</th><th scope="col">Needed by</th><th scope="col">Promised</th></tr></thead><tbody><#list view.lines as line><tr><td>${line.orderItemSeqId}</td><td>${line.productText}<#if line.otherPartyProductId><br><small>Your code ${line.otherPartyProductId}</small></#if><#if line.description><br><small>${line.description}</small></#if></td><td>${line.quantityText} ${line.unitText}<#if line.deliveredText><br><small>${line.deliveredText} delivered</small></#if></td><td>${line.priceText || ''}</td><td>${line.totalText || ''}</td><td>${line.requiredText || ''}</td><td>${line.promisedDate || ''}<#if line.promisedQuantity> (${line.promisedQuantity})</#if></td></tr></#list></tbody></table></div>
<p><a href="${billPath}">Send a bill for this order</a></p></section>
<#if view.subcontractList.length><section class="card" id="SubcontractWork" aria-label="Outside processing"><h2>Your work on our components</h2><#list view.subcontractList as work><article><p><strong>Line ${work.orderItemSeqId}</strong>: ${work.operationText}<#if work.dueText> · due ${work.dueText}</#if></p><#if work.custodyText><p>Our components held at ${work.custodyText}<#if !work.componentList.length>: none yet</#if></p></#if><#if work.componentList.length><ul><#list work.componentList as component><li>${component.productText}: ${component.quantityText}</li></#list></ul></#if></article></#list><p><small>The components stay ours while you hold them.</small></p></section></#if>
<#if view.acknowledgement><section class="card" id="AcknowledgementReceipt" aria-live="polite"><h2>Acknowledged</h2><dl><dt>Response</dt><dd>${view.acknowledgement.outcomeText}</dd><dt>When</dt><dd>${view.acknowledgement.dateText}</dd><#if view.acknowledgement.reference><dt>Your reference</dt><dd>${view.acknowledgement.reference}</dd></#if><#if view.acknowledgement.note><dt>Your note</dt><dd class="wrap">${view.acknowledgement.note}</dd></#if><#if view.receipt><dt>Status</dt><dd>${view.receipt.stateText}</dd></#if></dl><p><small>The buyer reviews any change; acknowledging changes no quantity or price.</small></p></section></#if>
<#if view.capabilities.canAcknowledge><form method="post" enctype="multipart/form-data" id="AcknowledgeOrder" class="card" action="${publicPath}/acknowledge"><h2>Acknowledge ${o.revisionText}</h2>
<input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><#if token><input type="hidden" name="token" value="${token}"><#else><input type="hidden" name="orderId" value="${o.orderId}"></#if>
<input type="hidden" name="operationId" value="${ackOperationId}"><input type="hidden" name="orderRevision" value="${o.revision}"><input type="hidden" name="lineSeqs" value="${view.lines.map(l => l.orderItemSeqId).join(',')}">
<fieldset><legend>Your response</legend><label><input type="radio" name="outcome" value="accept" checked> Accept as ordered</label><label><input type="radio" name="outcome" value="change"> Accept with changes (give the reason)</label><label><input type="radio" name="outcome" value="reject"> Reject (give the reason)</label></fieldset>
<label>Your order reference <input name="otherPartyOrderId" maxlength="60"></label>
<#list view.lines as line><fieldset class="card" id="AckLine${line.orderItemSeqId}"><legend>Line ${line.orderItemSeqId}: ${line.productText} · ${line.quantityText} ${line.unitText}<#if line.requiredText>, needed by ${line.requiredText}</#if></legend>
<label>Promised date <input type="date" name="promised_${line.orderItemSeqId}" value="${line.promisedDate || ''}"></label>
<label>Promised quantity <input name="promisedQty_${line.orderItemSeqId}" inputmode="decimal" size="10" value="${line.promisedQuantity || ''}"></label></fieldset></#list>
<label>Reason or note <textarea name="note" rows="3" maxlength="1000"></textarea></label>
<label>Confirmation file (PDF, PNG or JPEG, at most 10 MB; optional) <input type="file" name="file" accept="application/pdf,image/png,image/jpeg"></label>
<p><button>Send acknowledgement</button></p></form></#if>
<#if view.capabilities.canReportDelivery><form method="post" id="ReportDelivery" class="card" action="${publicPath}/deliver"><h2>Report a delivery to the customer</h2>
<input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><#if token><input type="hidden" name="token" value="${token}"><#else><input type="hidden" name="orderId" value="${o.orderId}"></#if>
<input type="hidden" name="operationId" value="${deliverOperationId}"><input type="hidden" name="lineSeqs" value="${view.lines.map(l => l.orderItemSeqId).join(',')}">
<#list view.lines as line><label>Line ${line.orderItemSeqId} shipped (of ${line.quantityText}) <input name="shipped_${line.orderItemSeqId}" inputmode="decimal" size="10"></label></#list>
<label>Tracking code <input name="trackingCode" maxlength="60"></label><label>Shipped on <input type="date" name="shippedDate"></label><label>Note <textarea name="note" rows="2" maxlength="500"></textarea></label>
<p><button>Report delivery</button></p><p><small>The buyer confirms the delivery; this report ships nothing.</small></p></form></#if>
<#if view.deliveryReports.length><section class="card" aria-label="Deliveries reported"><h2>Deliveries reported</h2><#list view.deliveryReports as report><p>${report.submittedText} · shipped ${report.shippedText}<#if report.trackingCode> · tracking ${report.trackingCode}</#if> · ${report.stateText}</p></#list></section></#if></#if>
