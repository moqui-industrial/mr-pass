<#if failure><h1>Request for quotation</h1><p role="alert" class="error">${failure.message}</p><#if failure.kind == 'AuthenticationRequired'><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath)}">Sign in</a></p></#if>
<#else><#assign q = view.quote><h1><#if q.requestId>Request for quotation ${q.requestId}<#else>Quote ${q.orderId}</#if></h1>
<#if quoteError><p role="alert" class="error">${quoteError}</p></#if><#if quoteSaved><p role="status">${quoteSaved}</p></#if>
<section class="card" id="PublishedQuoteRequest" aria-label="Request"><p><strong>${q.buyerName}</strong> asks ${q.supplierName} for a quote<#if q.title>: ${q.title}</#if></p>
<dl><#if q.revisionText><dt>Revision</dt><dd>${q.revisionText}</dd></#if><#if q.dueText><dt>Respond by</dt><dd>${q.dueText}<#if q.late> <strong class="error">(late)</strong></#if></dd></#if><dt>Currency</dt><dd>${q.currencyUomId}</dd><dt>Status</dt><dd>${q.statusText}</dd></dl>
<#if q.specification><h3>Specification</h3><p class="wrap">${q.specification}</p></#if>
<div class="table-wrap"><table class="lines"><caption>Items</caption><thead><tr><th scope="col">Line</th><th scope="col">Item</th><th scope="col">Qty</th><th scope="col">Needed by</th><th scope="col">Your price</th></tr></thead><tbody><#list view.lines as line><tr><td>${line.orderItemSeqId}</td><td>${line.productText}<#if line.description><br><small>${line.description}</small></#if></td><td>${line.quantityText} ${line.unitText}</td><td>${line.requiredText || ''}</td><td>${line.unitAmountText || ''}</td></tr></#list></tbody></table></div></section>
<#if view.receipt><section class="card" id="SubmitResponse" aria-live="polite"><h2>Quote received</h2><dl><dt>Sent</dt><dd>${view.receipt.submittedText}<#if view.receipt.late> (after the response date)</#if></dd><#if view.receipt.revisionText><dt>For</dt><dd>${view.receipt.revisionText}</dd></#if><#if view.receipt.reference><dt>Your reference</dt><dd>${view.receipt.reference}</dd></#if><#if view.receipt.totalText><dt>Total</dt><dd>${view.receipt.totalText}</dd></#if><dt>Status</dt><dd>${view.receipt.stateText}</dd></dl><p><small>The buyer reviews your quote; sending it does not award the order.</small></p></section></#if>
<#if view.capabilities.canSubmit><form method="post" enctype="multipart/form-data" id="SupplierOffer" class="card" action="${publicPath}/respond"><h2>Your quote</h2>
<input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><#if token><input type="hidden" name="token" value="${token}"><#else><input type="hidden" name="orderId" value="${q.orderId}"></#if>
<input type="hidden" name="operationId" value="${submitOperationId}"><input type="hidden" name="rfqRevision" value="${q.revision}"><input type="hidden" name="lineSeqs" value="${view.lines.map(l => l.orderItemSeqId).join(',')}">
<#if view.draft><p><small>Draft saved ${view.draft.savedText}.</small></p></#if>
<label>Your quote reference <input name="otherPartyOrderId" maxlength="60" value="${q.otherPartyOrderId || ''}"></label>
<label>Valid through <input type="date" name="validThruDate" value="${q.validThruDate || ''}"></label>
<label>Delivery by <input type="date" name="estimatedDeliveryDate" value="${q.estimatedDeliveryDate || ''}"></label>
<#list view.lines as line><fieldset class="card" id="OfferLine${line.orderItemSeqId}"><legend>Line ${line.orderItemSeqId}: ${line.productText} · ${line.quantityText} ${line.unitText}</legend>
<label>Unit price (${q.currencyUomId}) <input name="price_${line.orderItemSeqId}" inputmode="decimal" size="12" value="${line.unitAmount || ''}"></label>
<label>Promised date <input type="date" name="promised_${line.orderItemSeqId}" value="${line.promisedDate || ''}"></label>
<label>Your item code <input name="code_${line.orderItemSeqId}" maxlength="60" size="16" value="${line.otherPartyProductId || ''}"></label></fieldset></#list>
<label>Note to the buyer <textarea name="note" rows="3" maxlength="1000">${q.note || ''}</textarea></label>
<label>Quote file (PDF, PNG or JPEG, at most 10 MB; optional) <input type="file" name="file" accept="application/pdf,image/png,image/jpeg"></label>
<label><input type="checkbox" name="confirm" value="true"> This is our quote, on the terms above<#if q.validThruDate> and valid through the date given</#if></label>
<p><button name="formAction" value="save">Save draft</button> <button name="formAction" value="send">Send quote</button></p>
<p><small>A draft is yours alone; the buyer sees the quote once you send it, and reviews it before any order.</small></p></form></#if></#if>
