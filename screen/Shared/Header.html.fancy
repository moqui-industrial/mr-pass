<!doctype html>
<html lang="${siteInfo.site.locale || 'en'}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><#if !passPublicPage><meta name="moquiSessionToken" content="${ec.web.sessionToken}"></#if><title>${siteInfo.site.name}</title><link rel="icon" href="data:,"><meta property="og:type" content="website"><meta property="og:title" content="${view?.title || siteInfo.site.name}"><meta property="og:site_name" content="${siteInfo.site.name}"><#if canonicalUrl><link rel="canonical" href="${canonicalUrl}"></#if>
<style>body{font:1rem/1.6 system-ui,sans-serif;max-width:78rem;margin:auto;padding:1rem;color:#243247;background:#f5f7fa}a{color:#1558a6}header,article,form,.card{background:white;padding:1rem;border-radius:.5rem;margin-bottom:1rem}nav{display:flex;flex-wrap:wrap;gap:1rem}main{max-width:65rem;margin:1rem auto}label{display:block;margin:.7rem 0}input,textarea,select,button{font:inherit;max-width:100%;padding:.5rem}fieldset{min-width:0;border:0;padding:0}textarea{display:block;width:95%;min-height:10rem}button{cursor:pointer;min-height:44px}img{max-width:100%}.skip{position:absolute;top:-100px}.skip:focus{top:0}dt{font-weight:600}dd{overflow-wrap:anywhere}.error{color:#962626}.table-wrap{overflow-x:auto}.lines{border-collapse:collapse;width:100%}.lines th,.lines td{text-align:left;padding:.3rem;vertical-align:top;border-bottom:1px solid #d5dce6}.wrap{overflow-wrap:anywhere}#public-root .q-layout,#public-root .q-page{min-height:0!important}@media(prefers-color-scheme:dark){body{background:#17202d;color:#eef3fa}header,article,form,.card{background:#243247}a{color:#9bc9ff}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}</style>
<#if passApp == 'smithy'><style>.smithy-crumbs{gap:.4rem}.smithy-tabs{flex-wrap:nowrap;overflow-x:auto;white-space:nowrap}.smithy-tabs a[aria-current]{font-weight:600;text-decoration:none}.smithy-chip{display:inline-block;font-size:.75rem;font-weight:400;padding:0 .5rem;border:1px solid currentColor;border-radius:1rem;vertical-align:middle}.smithy-row h3,.smithy-row p{margin:.2rem 0}.smithy-pre{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;margin:0}.smithy-code,.smithy-diff{overflow-x:auto;max-width:100%;box-sizing:border-box;font:.85rem/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;margin:0 0 1rem;tab-size:4}.smithy-code .n{display:inline-block;min-width:4ch;margin-right:1.5ch;text-align:right;text-decoration:none;opacity:.6;user-select:none}.smithy-code span:target{background:#fff3c4}.smithy-diff .a{background:#e3f6e8}.smithy-diff .d{background:#fde7ea}.smithy-diff .h{opacity:.7}.smithy-lines{overflow-x:auto;max-width:100%;font:.85rem/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;tab-size:4;margin:0 0 1rem}.smithy-lines .l{white-space:pre;min-width:max-content}.smithy-lines .l.a{background:#e3f6e8}.smithy-lines .l.d{background:#fde7ea}.smithy-lines .l.h,.smithy-lines .l.m{opacity:.7}.smithy-lines .n{display:inline-block;min-width:5ch;padding:0 .5ch;margin-right:1ch;text-align:right;text-decoration:none;opacity:.7;user-select:none}.smithy-lines .l:target{outline:2px solid #e2a400}.smithy-thread{font:1rem/1.6 system-ui,sans-serif;white-space:normal;max-width:min(52rem,calc(100vw - 4rem));position:sticky;left:0;border-left:3px solid #1558a6;padding:.3rem .8rem;margin:.4rem 0;background:#fff;box-sizing:border-box}.smithy-thread textarea,.smithy-editor{width:100%;box-sizing:border-box}.smithy-editor{font:.85rem/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;tab-size:4}.smithy-blame{border-collapse:collapse;font:.85rem/1.5 ui-monospace,SFMono-Regular,Menlo,monospace}.smithy-blame td,.smithy-blame th{padding:0 .6rem 0 0;text-align:left;vertical-align:top;white-space:nowrap}.smithy-blame pre{margin:0;font:inherit;tab-size:4}.smithy-blame tr.s td{border-top:1px solid #d5dce6}.smithy-blame .n{text-align:right}.smithy-blame .n a{text-decoration:none;opacity:.6}.smithy-blame small{font-family:system-ui,sans-serif}.smithy-blame tr:target{background:#fff3c4}.smithy-clone label{margin:.5rem 0}.smithy-clone input{width:100%;box-sizing:border-box}form.smithy-inline{display:inline;background:none;padding:0;margin:0;border-radius:0}.smithy-inline label{display:inline-block;margin:.3rem .5rem .3rem 0}.smithy-row details{margin:.5rem 0}.smithy-row form.smithy-inline{display:block;margin:.3rem 0}header nav{align-items:center}article pre,article table{max-width:100%;overflow-x:auto}.smithy-issue{display:grid;grid-template-columns:minmax(0,1fr) 18rem;gap:1rem;align-items:start}.smithy-issue>div,.smithy-side{min-width:0}.smithy-side summary{cursor:pointer;overflow-wrap:anywhere}.smithy-label{border-width:2px}.smithy-post h3{margin:0 0 .5rem;font-size:1rem}.smithy-body pre,.smithy-body table,.smithy-preview pre,.smithy-preview table{max-width:100%;overflow-x:auto}.smithy-event{margin:.5rem 1rem}.smithy-preview{border:1px dashed currentColor;border-radius:.5rem;padding:0 1rem;margin-bottom:1rem}.reactions form.smithy-inline{display:inline-block;margin:0 .3rem 0 0}.smithy-composer fieldset label{display:inline-block;margin-right:1rem}@media(max-width:60rem){.smithy-issue{grid-template-columns:minmax(0,1fr)}}@media(max-width:40rem){.smithy-wide{display:none}}@media(prefers-color-scheme:dark){.smithy-blame tr:target{background:#5b4a08}.smithy-code span:target{background:#5b4a08}.smithy-diff .a,.smithy-lines .l.a{background:#17402a}.smithy-diff .d,.smithy-lines .l.d{background:#532329}.smithy-thread{background:#22324a}}</style></#if>
<#if siteInfo.brand><style>${siteInfo.brand.backgroundColor ? 'body{background:' + siteInfo.brand.backgroundColor + '}' : ''}${siteInfo.brand.textColor ? 'body{color:' + siteInfo.brand.textColor + '}' : ''}${siteInfo.brand.surfaceColor ? 'header,article,form,.card{background:' + siteInfo.brand.surfaceColor + '}' : ''}${siteInfo.brand.primaryColor ? 'a{color:' + siteInfo.brand.primaryColor + '}' : ''}</style></#if></head><body>
<#if passApp == 'smithy'><a href="#main" class="skip">Skip to content</a><header><#if siteInfo.brand?.logoUrl><img src="${siteInfo.brand.logoUrl}" alt="" height="32"> </#if><a href="${passBases.smithy || '/'}"><strong>${siteInfo.site.name}</strong></a><nav aria-label="Code">
<a href="${passBases.smithy}/explore">Explore</a><#if (siteInfo.mounts || []).some(m => m.app == 'forum')><a href="${passBases.forum || '/'}">Forum</a></#if><#if siteInfo.authenticated && !passPublicPage><a href="${passBases.smithy}/new/repository">New repository</a><a href="${passBases.smithy}/new/group">New group</a><#if siteInfo.capabilities.canManageSite><a href="${passBases.smithy}/-/site">Site settings</a></#if><a href="${passBases.account}/Home">My account</a><a href="${passBases.account}/GitAccess">Git access</a><form method="post" action="${passBases.account}/Settings/save" class="smithy-inline" id="SmithySignOut"><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="formAction" value="endSession"><button>Sign out</button></form><#else><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath || '')}">Sign in</a><#if siteInfo.site.registrationMode == 'open'><a href="${passBases.account}/Register">Register</a></#if></#if></nav></header><main id="main" tabindex="-1">
<#elseif passApp == 'billing' || passApp == 'supplier' || passApp == 'support' || passApp == 'shop' || !(siteInfo.mounts || []).some(m => m.app == 'forum')><a href="#main" class="skip">Skip to content</a><header><#if siteInfo.brand?.logoUrl><img src="${siteInfo.brand.logoUrl}" alt="" height="32"> </#if><strong>${siteInfo.site.name}</strong><nav aria-label="${passApp == 'supplier' ? 'Supplier' : passApp == 'support' ? 'Support' : passApp == 'shop' ? 'Shop' : 'Billing'}">
<#if (siteInfo.mounts || []).some(m => m.app == 'shop')><a href="${passBases.shop || '/'}">Shop</a><#if passApp == 'shop'><a href="${passBases.shop || ''}/Cart">Cart</a><#if siteInfo.authenticated && !passPublicPage><a href="${passBases.shop || ''}/Account">Your purchases</a></#if></#if></#if><#if passApp == 'support'><a href="${passBases.support}/SupportHome">Help</a><#if siteInfo.authenticated><a href="${passBases.support}/MyCases">My cases</a><a href="${passBases.support}/MyReturns">My returns</a><a href="${passBases.support}/NewCustomerCase">Contact support</a></#if></#if><#if siteInfo.authenticated && (siteInfo.mounts || []).some(m => m.app == 'billing')><a href="${passBases.billing}/Invoices">Invoices</a></#if><#if siteInfo.authenticated && (siteInfo.mounts || []).some(m => m.app == 'supplier')><a href="${passBases.supplier}/SupplierHome">Supplier documents</a></#if><#if passPublicPage><a href="${passBases.account}/Settings">Account</a><#elseif siteInfo.authenticated><a href="${passBases.account}/Home">My account</a><#else><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath || '')}">Sign in</a></#if></nav></header><main id="main" tabindex="-1">
<#else><a href="#main" class="skip">Skip to discussion</a><header><strong>${siteInfo.site.name}</strong><nav aria-label="Community">
<a href="${passBases.forum}">Topics</a><a href="${passBases.forum}/Categories">Categories</a><a href="${passBases.forum}/Tags">Tags</a><a href="${passBases.forum}/Search">Search</a><a href="${passBases.forum}/Guidelines">Guidelines</a>
<#if siteInfo.authenticated><a href="${passBases.forum}/Compose">New topic</a><a href="${passBases.forum}/Drafts">Drafts</a><a href="${passBases.forum}/Bookmarks">Bookmarks</a><a href="${passBases.forum}/Messages">Messages</a><a href="${passBases.account}/Notifications">Notifications</a><a href="${passBases.account}/Settings">Account</a><#else><a href="${passBases.account}/Login">Sign in</a><#if siteInfo.site.registrationMode == 'open'><a href="${passBases.account}/Register">Register</a></#if></#if>
<#if siteInfo.capabilities.canModerateSite><a href="${passBases.forum}/Moderation/ReviewQueue">Review</a><a href="${passBases.forum}/Moderation/Log">Moderation log</a><a href="${passBases.forum}/Reports/Activity">Activity</a></#if>
<#if siteInfo.capabilities.canManageSite><a href="${passBases.sites}/SiteDetail">Site settings</a><a href="${passBases.forum}/Settings/Categories">Manage categories</a><a href="${passBases.forum}/Settings/Members">Members</a><a href="${passBases.forum}/Settings/Policies">Policies</a><a href="${passBases.forum}/Settings/Mail">Mail</a><a href="${passBases.forum}/Settings/Operations">Operations</a><a href="${passBases.forum}/Settings/Import">Import</a></#if><a href="${passBases.forum}/feed">RSS</a></nav></header><main id="main" tabindex="-1"></#if>
