<!-- MethodRelay (impl-shop P6, F40): the hosted profile page's form token posted at once to the provider; only this route's CSP (and PaymentRelay's) allows the provider's form-action (Shared/Headers.js). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Add a card">
  <!-- pre-actions: run before the PASS shell renders, so a redirect leaves at once (F78) -->
  <pre-actions>
    <script><![CDATA[
        shopPage=ec.resource.script('component://mr-pass/screen/Shop/ShopAccount.js').render(shopContext,'relay')
        if(shopPage.redirect)sri.sendRedirectAndStopRender(shopPage.redirect)
    ]]></script>
  </pre-actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Shop/CheckoutPage.html.fancy"/>
    </render-mode>
  </widgets>
</screen>
