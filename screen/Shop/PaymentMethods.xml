<!-- PaymentMethods (design-shop §9 PaymentMethods; impl-shop P6): the buyer's cards, masked, with the recurring orders each pays (getPaymentMethods); add goes to the store gateway's hosted setup page (beginPaymentMethodSetup) and return asks the provider for the cards (finishPaymentMethodSetup); end names the orders it affects and needs confirming (endPaymentMethod). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Payment methods">
  <transition name="add" method="post">
    <actions>
      <script>ec.resource.script('component://mr-pass/screen/Shop/ShopAccount.js').act(shopContext,'addMethod')</script>
    </actions>
    <default-response type="none"/>
  </transition>
  <transition name="return">
    <actions>
      <script>ec.resource.script('component://mr-pass/screen/Shop/ShopAccount.js').act(shopContext,'methodReturned')</script>
    </actions>
    <default-response type="none"/>
  </transition>
  <transition name="end" method="post">
    <actions>
      <script>ec.resource.script('component://mr-pass/screen/Shop/ShopAccount.js').act(shopContext,'endMethod')</script>
    </actions>
    <default-response type="none"/>
  </transition>
  <!-- pre-actions: run before the PASS shell renders, so a redirect leaves at once (F78) -->
  <pre-actions>
    <script><![CDATA[
        shopPage=ec.resource.script('component://mr-pass/screen/Shop/ShopAccount.js').render(shopContext,'paymentMethods')
        if(shopPage.redirect)sri.sendRedirectAndStopRender(shopPage.redirect)
    ]]></script>
  </pre-actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Shop/CheckoutPage.html.fancy"/>
    </render-mode>
  </widgets>
</screen>
