<!-- Document (design-shop §9 PurchaseDocuments; impl-shop P6): one issued invoice of a reached order (getShopOrderDocument). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Invoice">
  <!-- pre-actions: run before the PASS shell renders, so a redirect leaves at once (F78) -->
  <pre-actions>
    <script><![CDATA[
        shopPage=ec.resource.script('component://mr-pass/screen/Shop/ShopAccount.js').render(shopContext,'document')
        if(shopPage.redirect)sri.sendRedirectAndStopRender(shopPage.redirect)
    ]]></script>
  </pre-actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Shop/CheckoutPage.html.fancy"/>
    </render-mode>
  </widgets>
</screen>
