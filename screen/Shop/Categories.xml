<!-- Categories (design-shop §5 Categories; impl-shop P3): the store's browse tree (List) and a category's page
    (CategoryDetail, routed from categories/{id}/{slug}). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Categories">
  <subscreens default-item="List"/>
  <widgets>
    <subscreens-active/>
  </widgets>
</screen>
