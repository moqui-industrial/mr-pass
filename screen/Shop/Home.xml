<!-- Home (design-shop §5 Home; impl-shop P1, P2, P3): the Shop root, the store's featured products (getShopPage's home kind).
    With a published theme it is the release's home page; without one the store's name, its featured products or the empty
    state in the PASS shell (Shop/Catalog.js). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Home">
  <always-actions>
    <script>shopPage=ec.resource.script('component://mr-pass/screen/Shop/Catalog.js').show(shopContext,'home',{})</script>
  </always-actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Shop/Catalog.html.fancy"/>
    </render-mode>
  </widgets>
</screen>
