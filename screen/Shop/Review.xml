<!-- Review (design-shop §5 PublicReviews and SubmitReview; Commerce P9): a product's approved reviews (getProductReviews) and,
    for a signed-in verified buyer whose order of it has arrived, the review form with up to three photos
    (submitProductReview; Shop/ShopReviews.js). Routed as Review?productId=; a product not public is "not available". -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Reviews">
  <transition name="submit" method="post">
    <actions>
      <script>ec.resource.script('component://mr-pass/screen/Shop/ShopReviews.js').submit(shopContext)</script>
    </actions>
    <default-response type="none"/>
  </transition>
  <!-- pre-actions: run before the PASS shell renders (as the account pages, F78) -->
  <pre-actions>
    <script><![CDATA[
        shopPage=ec.resource.script('component://mr-pass/screen/Shop/ShopReviews.js').render(shopContext)
    ]]></script>
  </pre-actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Shop/CheckoutPage.html.fancy"/>
    </render-mode>
  </widgets>
</screen>
