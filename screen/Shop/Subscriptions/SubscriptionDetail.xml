<!-- SubscriptionDetail (design-shop §10 SubscriptionDetail; impl-shop P7): one of the buyer's subscriptions (getSubscription): Subscription, RenewalHistory, ChangeMethod, CancelRenewal, ResolveRenewal and RenewPrepaid. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Your subscription">
  <parameter name="contractId"/>
  <!-- pre-actions: run before the PASS shell renders, so a redirect leaves at once (F78) -->
  <pre-actions>
    <script><![CDATA[
        shopPage=ec.resource.script('component://mr-pass/screen/Shop/ShopSubscriptions.js').render(shopContext,'detail')
        if(shopPage.redirect)sri.sendRedirectAndStopRender(shopPage.redirect)
    ]]></script>
  </pre-actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Shop/CheckoutPage.html.fancy"/>
    </render-mode>
  </widgets>
</screen>
