<!-- Page (design-shop §5 Page; impl-shop P3): the site's page of the Shop mount live at pages/{route}, its exact published wiki
    version (Commerce P4's get#SitePage by mount, route and locale, through getShopPage's page kind); a route with no live
    page is redirected when the site redirects it, else the not-found page (Shop/Catalog.js). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Page">
  <parameter name="routePath"/>
  <always-actions>
    <script><![CDATA[
        shopPage=ec.resource.script('component://mr-pass/screen/Shop/Catalog.js').show(shopContext,'page',{routePath:String(routePath || '')},{path:String(publicPath || '')})
    ]]></script>
  </always-actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Shop/Catalog.html.fancy"/>
    </render-mode>
  </widgets>
</screen>
