<!-- Search (design-shop §5 Search; impl-shop P3): the store's public products whose index document or name matches q, and
    its live Shop pages by title, a page at a time; no-match, an invalid query and an unavailable search are their own
    states; a search with a query is noindex (getShopPage's search kind; Shop/Catalog.js). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Search">
  <always-actions>
    <script><![CDATA[
        const catalog=ec.resource.script('component://mr-pass/screen/Shop/Catalog.js')
        shopPage=catalog.show(shopContext,'search',{query:catalog.param('q'),sort:catalog.param('sort'),cursor:catalog.param('cursor')})
    ]]></script>
  </always-actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Shop/Catalog.html.fancy"/>
    </render-mode>
  </widgets>
</screen>
