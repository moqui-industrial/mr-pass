<!-- Subscriptions (design-shop §10 Subscriptions, SubscriptionDetail; impl-shop P7): the signed-in verified buyer's subscriptions with billing and access apart and the store's offers (SubscriptionList, getSubscriptions); one subscription (SubscriptionDetail, routed from Subscriptions/{contractId}); and its forms: Subscribe or RenewPrepaid (beginSubscriptionPurchase, then the checkout), ChangeMethod, CancelRenewal and ResolveRenewal. PublicSite.subscriptionUrl points here. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Your subscriptions">
  <transition name="purchase" method="post">
    <actions>
      <script>ec.resource.script('component://mr-pass/screen/Shop/ShopSubscriptions.js').act(shopContext,'purchase')</script>
    </actions>
    <default-response type="none"/>
  </transition>
  <transition name="method" method="post">
    <actions>
      <script>ec.resource.script('component://mr-pass/screen/Shop/ShopSubscriptions.js').act(shopContext,'changeMethod')</script>
    </actions>
    <default-response type="none"/>
  </transition>
  <transition name="cancel" method="post">
    <actions>
      <script>ec.resource.script('component://mr-pass/screen/Shop/ShopSubscriptions.js').act(shopContext,'cancel')</script>
    </actions>
    <default-response type="none"/>
  </transition>
  <transition name="resume" method="post">
    <actions>
      <script>ec.resource.script('component://mr-pass/screen/Shop/ShopSubscriptions.js').act(shopContext,'resume')</script>
    </actions>
    <default-response type="none"/>
  </transition>
  <subscreens default-item="SubscriptionList"/>
  <widgets>
    <subscreens-active/>
  </widgets>
</screen>
