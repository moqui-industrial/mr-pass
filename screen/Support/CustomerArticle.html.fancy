<#if failure><h1>Help</h1><p role="alert" class="error">${failure.message}</p><p><a href="${passBases.support}/SupportHome">Search our help</a></p>
<#else><#assign a = view.article><article id="CustomerArticleBody"><h1>${a.title}</h1>${raw(a.body)}</article>
<#if flash.notice><p role="status" class="card">${flash.notice}</p></#if><#if flash.error><p role="alert" class="error">${flash.error}</p></#if>
<#if !rated><form method="post" id="ArticleRating" class="card" action="${publicPath}/rate"><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="wikiPageId" value="${a.wikiPageId}"><input type="hidden" name="nonce" value="${view.nonce}">
<fieldset><legend>Was this helpful?</legend><label><input type="radio" name="helpful" value="Y" required> Yes</label><label><input type="radio" name="helpful" value="N"> No</label></fieldset>
<label>Tell us more (optional) <textarea name="comment" rows="3" maxlength="2000"></textarea></label><p><button>Send</button></p></form></#if>
<p class="card"><#if view.capabilities.canCreateCase><a href="${passBases.support}/NewCustomerCase?wikiPageId=${encodeURIComponent(a.wikiPageId)}">Still need help? Contact support</a><#else><a href="${passBases.support}/SupportHome">More help</a></#if></p></#if>
