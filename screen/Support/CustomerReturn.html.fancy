<#if failure><h1>Your return</h1><#if flash.notice><p role="status" class="card">${flash.notice}</p><#else><p role="alert" class="error">${failure.message}</p></#if><#if failure.kind == 'AuthenticationRequired'><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath + '?' + returnQuery)}">Sign in</a></p></#if>
<#else><#assign r = view.return><h1>Return ${r.reference}</h1>
<#if flash.notice><p role="status" class="card">${flash.notice}</p></#if><#if flash.error><p role="alert" class="error">${flash.error}</p></#if>
<section class="card" id="ReturnSummary"><p><strong>${r.statusText}</strong></p><dl><#if r.orderId><dt>Order</dt><dd>${r.orderId}</dd></#if><#if r.customerReference><dt>Your reference</dt><dd>${r.customerReference}</dd></#if><dt>Requested</dt><dd>${r.enteredText}</dd><#if r.expiryText><dt>Send back by</dt><dd>${r.expiryText}</dd></#if></dl>
<#if r.instructions><h2>What to do</h2><p class="wrap">${r.instructions}</p></#if>
<#if view.capabilities.canDownloadLabel><p><a href="${publicPath}/label?${returnQuery}" id="ReturnLabel">Download your return label</a></p></#if>
<#list view.trackingList as t><p>Tracking <#if t.trackingUrl><a href="${t.trackingUrl}" rel="noopener noreferrer">${t.trackingCode}</a><#else>${t.trackingCode}</#if></p></#list></section>
<section class="card" aria-label="Items"><h2>Items</h2><div class="table-wrap"><table class="lines"><thead><tr><th>Item</th><th>Quantity</th><th>Received</th><th>Why</th><th>You asked for</th><th></th></tr></thead><tbody><#list view.lineList as l><tr><td class="wrap">${l.productText}</td><td>${l.quantity}</td><td>${l.receivedQuantity}</td><td>${l.reasonText}</td><td>${l.remedyText}</td><td>${l.issuedText}</td></tr></#list></tbody></table></div></section>
<#if view.evidenceList.length><section class="card" aria-label="What you sent"><h2>What you sent us</h2><ul><#list view.evidenceList as e><li>${e.description} <small>${e.dateText}</small></li></#list></ul></section></#if>
<#if view.capabilities.canAddEvidence><form method="post" enctype="multipart/form-data" id="ReturnEvidence" class="card" action="${publicPath}/evidence"><h2>Add a photo or a message</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="operationId" value="${evidenceOperationId}"><#if token><input type="hidden" name="token" value="${token}"><#else><input type="hidden" name="returnId" value="${r.returnId}"></#if>
<label>Message <textarea name="note" rows="3" maxlength="2000"></textarea></label><label>A file (PDF, PNG or JPEG, at most 10 MB) <input type="file" name="file" accept="application/pdf,image/png,image/jpeg"></label><p><button>Send</button></p></form></#if>
<#if view.capabilities.canWithdraw><form method="post" id="ReturnWithdraw" class="card" action="${publicPath}/withdraw"><h2>Changed your mind?</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="operationId" value="${withdrawOperationId}"><input type="hidden" name="expectedRevision" value="${r.revision}"><#if token><input type="hidden" name="token" value="${token}"><#else><input type="hidden" name="returnId" value="${r.returnId}"></#if><label>Why (optional) <input name="reason" maxlength="255"></label><p><button>Withdraw this return</button></p></form>
<#elseif view.capabilities.askAgent><p class="card" id="ReturnAskAgent">To change or cancel this return now, reply to our email or <a href="${passBases.support}/NewCustomerCase">contact support</a>.</p></#if></#if>
