<#if failure><h1>Your case</h1><p role="alert" class="error">${failure.message}</p><#if failure.kind == 'AuthenticationRequired'><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath + '?' + caseQuery)}">Sign in</a></p></#if>
<#else><#assign c = view.case><h1>${c.title}</h1>
<#if flash.notice><p role="status" class="card">${flash.notice}</p></#if><#if flash.error><p role="alert" class="error">${flash.error}</p></#if>
<section class="card" id="CaseSummary"><p><strong>${c.statusText}</strong><#if c.waitingForCustomer> · <span class="error">We are waiting for your reply</span></#if></p><dl><dt>Case</dt><dd>${c.requestId}</dd><dt>For</dt><dd>${c.customerName}</dd><dt>Opened</dt><dd>${c.createdText}</dd><dt>Updated</dt><dd>${c.updatedText}</dd></dl>
<#if c.description><h2>Your request</h2><p class="wrap">${c.description}</p></#if>
<#if view.valueList.length><dl><#list view.valueList as v><dt>${v.title}</dt><dd class="wrap">${v.valueText}</dd></#list></dl></#if>
<#if view.linkList.length><p><#list view.linkList as l><#if l.kind == 'return'><a href="${passBases.support}/CustomerReturn?returnId=${encodeURIComponent(l.returnId)}">${l.text}</a><#else>${l.text} · <a href="${passBases.support}/NewCustomerCase?orderId=${encodeURIComponent(l.orderId)}">Ask to cancel</a></#if> </#list></p></#if></section>
<#if view.hoursNotice><p class="card" role="status">${view.hoursNotice.message}.</p></#if>
<section class="card" id="CaseConversation" aria-label="Conversation"><h2>Conversation</h2><#if !view.messageList.length><p>No messages yet.</p></#if>
<#list view.messageList as m><article class="<#if m.fromCustomer>mine</#if>"><p><strong>${m.fromText}</strong> · <small>${m.dateText}</small></p><p class="wrap">${m.body}</p></article></#list></section>
<#if view.fileList.length><section class="card" id="CaseFiles" aria-label="Files"><h2>Files</h2><ul><#list view.fileList as f><li><a href="${publicPath}/file?${caseQuery}&amp;fileId=${encodeURIComponent(f.fileId)}">${f.filename}</a> <small>${f.dateText}</small></li></#list></ul></section></#if>
<#if view.capabilities.canReply><form method="post" enctype="multipart/form-data" id="CaseReply" class="card" action="${publicPath}/reply"><h2>Reply</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="operationId" value="${replyOperationId}"><#if token><input type="hidden" name="token" value="${token}"><#else><input type="hidden" name="requestId" value="${c.requestId}"></#if>
<label>Your message <textarea name="body" rows="5" maxlength="20000" required></textarea></label><#if view.capabilities.canAddFile><label>A file (PDF, PNG or JPEG, at most 10 MB) <input type="file" name="file" accept="application/pdf,image/png,image/jpeg"></label></#if>
<#if view.capabilities.followUpOnReply><p><small>This case is closed; a reply opens a new case.</small></p></#if><p><button>Send</button></p></form></#if>
<#if view.capabilities.canReopen><form method="post" id="CaseReopen" class="card" action="${publicPath}/reopen"><h2>Not resolved?</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="operationId" value="${reopenOperationId}"><#if token><input type="hidden" name="token" value="${token}"><#else><input type="hidden" name="requestId" value="${c.requestId}"></#if><label>What is still wrong? <textarea name="reason" rows="3" maxlength="2000" required></textarea></label><p><button>Ask to reopen</button></p></form></#if>
<#if view.capabilities.canCancel><form method="post" id="CaseCancel" class="card" action="${publicPath}/cancel"><h2>No longer needed?</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="expectedRevision" value="${c.revision}"><#if token><input type="hidden" name="token" value="${token}"><#else><input type="hidden" name="requestId" value="${c.requestId}"></#if><label>Why (optional) <input name="reason" maxlength="500"></label><p><button>Cancel this request</button></p></form></#if></#if>
