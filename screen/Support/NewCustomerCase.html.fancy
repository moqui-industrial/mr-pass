<h1>Contact support</h1>
<#if flash.notice><p role="status" class="card">${flash.notice}</p></#if><#if flash.error><p role="alert" class="error">${flash.error}</p></#if>
<#if failure><p role="alert" class="error">${failure.message}</p><#if failure.kind == 'AuthenticationRequired'><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath || '')}">Sign in</a></p></#if>
<#elseif received><section class="card" id="CaseReceipt" aria-live="polite"><h2>Thank you</h2><p>We have your request and will answer you by email.</p></section>
<#else>
<#if view.order><section class="card" id="OrderCancelRequest"><h2>Cancel order ${view.order.orderId}</h2><#if view.order.placedText><p><small>Placed ${view.order.placedText}</small></p></#if>
<#list view.order.requestList as r><p><strong>${r.stateText}</strong> · asked ${r.requestedText}<#list r.lines as l> · ${l.productText} × ${l.quantity}</#list></p></#list>
<#if view.order.capabilities.canRequestCancel><form method="post" action="${publicPath}/cancelOrder"><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="orderId" value="${view.order.orderId}"><input type="hidden" name="operationId" value="${cancelOperationId}">
<fieldset><legend>Lines to cancel</legend><#list view.order.lines as l><div class="field"><label><input type="checkbox" name="cancel_${l.orderItemSeqId}" value="Y"> ${l.productText}</label><label>Quantity (up to ${l.openQuantity}) <input name="quantity_${l.orderItemSeqId}" value="${l.openQuantity}" inputmode="decimal" size="6"></label></div></#list></fieldset>
<label>Why do you want to cancel? <textarea name="reason" rows="3" maxlength="2000"></textarea></label>
<label><input type="checkbox" name="consent" value="Y" required> I ask ${view.organizationName} to cancel these lines</label>
<p><button>Ask to cancel</button></p><p><small>Anything already shipped cannot be cancelled here; we confirm what we cancel.</small></p></form>
<#else><p>Nothing on this order can be cancelled here now. Send us a request below.</p></#if></section></#if>
<#if queue && queue.hoursNotice><p class="card" role="status">${queue.hoursNotice.message}. We still take your request now.</p></#if>
<#if view.articleList.length><section class="card" aria-label="Answers that may help"><h2>These may answer your question</h2><ul><#list view.articleList as a><li><a href="${passBases.support}/CustomerArticle?wikiPageId=${encodeURIComponent(a.wikiPageId)}">${a.title}</a></li></#list></ul></section></#if>
<#if !view.capabilities.canSubmit><p>No request form is open for you now.</p>
<#else>
<#if (view.queues.length > 1 || (queue && queue.types.length > 1))><form method="get" class="card" action="${publicPath}" id="CaseTopic"><#if token><input type="hidden" name="token" value="${token}"></#if><#if orderId><input type="hidden" name="orderId" value="${orderId}"></#if><#if wikiPageId><input type="hidden" name="wikiPageId" value="${wikiPageId}"></#if>
<#if (view.queues.length > 1)><label>Your request is about <select name="requestCategoryId"><#list view.queues as q><option value="${q.requestCategoryId}"<#if q.requestCategoryId == queue.requestCategoryId> selected</#if>>${q.name}</option></#list></select></label></#if>
<#if (queue.types.length > 1)><label>Kind of request <select name="requestTypeEnumId"><#list queue.types as t><option value="${t.requestTypeEnumId}"<#if t.requestTypeEnumId == type.requestTypeEnumId> selected</#if>>${t.text}</option></#list></select></label></#if><button>Choose</button></form></#if>
<form method="post" enctype="multipart/form-data" id="NewCustomerCaseForm" class="card" action="${publicPath}/submit"><h2>Your request</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="operationId" value="${submitOperationId}"><input type="hidden" name="fieldNames" value="${fieldNames}">
<#if token><input type="hidden" name="token" value="${token}"></#if><#if orderId><input type="hidden" name="orderId" value="${orderId}"></#if><#if view.article><input type="hidden" name="wikiPageId" value="${view.article.wikiPageId}"><p>About the article <a href="${passBases.support}/CustomerArticle?wikiPageId=${encodeURIComponent(view.article.wikiPageId)}">${view.article.title}</a></p></#if>
<input type="hidden" name="requestCategoryId" value="${queue.requestCategoryId}"><input type="hidden" name="requestTypeEnumId" value="${type.requestTypeEnumId}">
<#if view.capabilities.needsSender><label>First name * <input name="firstName" maxlength="60" required autocomplete="given-name"></label><label>Last name * <input name="lastName" maxlength="60" required autocomplete="family-name"></label><label>Email * <input type="email" name="emailAddress" maxlength="254" required autocomplete="email"></label><div aria-hidden="true" style="position:absolute;left:-10000px"><label>Website <input name="website" tabindex="-1" autocomplete="off"></label></div></#if>
<#if (view.customers.length > 1)><label>For * <select name="customerPartyId" required><#list view.customers as c><option value="${c.partyId}">${c.name}</option></#list></select></label></#if>
<label>Subject * <input name="requestName" maxlength="255" required value="${query || ''}"></label>
<label>What do you need? * <textarea name="description" rows="6" maxlength="20000" required></textarea></label>
<#list caseFields as f><div class="field" id="field_${f.fieldName}"<#if f.showText> data-visible-when="${f.showText}"</#if><#if f.requireText> data-require-when="${f.requireText}"</#if>>
<#if f.kind == 'radio'><fieldset><legend>${f.title}<#if f.required> *</#if></legend><#list f.options as o><label><input type="radio" name="tv_${f.fieldName}" value="${o.key}"<#if f.required> required</#if>> ${o.text}</label></#list></fieldset>
<#elseif f.kind == 'checks'><fieldset><legend>${f.title}</legend><#list f.options as o><label><input type="checkbox" name="tv_${f.fieldName}" value="${o.key}"> ${o.text}</label></#list></fieldset>
<#elseif f.kind == 'select'><label>${f.title}<#if f.required> *</#if> <select name="tv_${f.fieldName}"<#if f.required> required</#if>><option value=""></option><#list f.options as o><option value="${o.key}">${o.text}</option></#list></select></label>
<#elseif f.kind == 'textarea'><label>${f.title}<#if f.required> *</#if> <textarea name="tv_${f.fieldName}" rows="3" maxlength="4000"<#if f.required> required</#if>></textarea></label>
<#elseif f.kind == 'date'><label>${f.title}<#if f.required> *</#if> <input type="date" name="tv_${f.fieldName}"<#if f.required> required</#if>></label>
<#else><label>${f.title}<#if f.required> *</#if> <input name="tv_${f.fieldName}" maxlength="255"<#if f.required> required</#if>></label></#if>
<#if f.tooltip><p><small>${f.tooltip}</small></p></#if></div></#list>
<label>A file (PDF, PNG or JPEG, at most 10 MB) <input type="file" name="file" accept="application/pdf,image/png,image/jpeg"></label>
<p><button>Send request</button></p></form><#if caseFields.length><script src="/js/moqui-form-when.js"></script></#if></#if></#if>
