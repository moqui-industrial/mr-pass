<h1>My cases</h1>
<#if flash.notice><p role="status" class="card">${flash.notice}</p></#if>
<#if !siteInfo.authenticated><p>Sign in to follow your requests.</p><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath || '')}">Sign in</a></p>
<#elseif failure><p role="alert" class="error">${failure.message}</p>
<#else><#if view.capabilities.canCreateCase><p><a href="${passBases.support}/NewCustomerCase">New request</a></p></#if>
<form method="get" id="MyCaseFind" class="card" role="search" action="${publicPath}"><label>Search <input type="search" name="q" value="${query || ''}" maxlength="100"></label>
<label>Show <select name="statusCategory"><option value="all"<#if statusCategory == 'all'> selected</#if>>All</option><option value="open"<#if statusCategory == 'open'> selected</#if>>Open</option><option value="resolved"<#if statusCategory == 'resolved'> selected</#if>>Resolved or cancelled</option></select></label>
<#if (view.customers.length > 1)><label>For <select name="customerPartyId"><option value="">Everyone I act for</option><#list view.customers as c><option value="${c.partyId}"<#if customerPartyId == c.partyId> selected</#if>>${c.name}</option></#list></select></label></#if><button>Find</button></form>
<section id="MyCaseList" aria-label="Cases"><#if !view.caseList.length><p class="card">No cases to show.</p></#if>
<#list view.caseList as row><article class="card"><h2><a href="${passBases.support}/CustomerCase?requestId=${encodeURIComponent(row.requestId)}">${row.title}</a></h2><p><strong>${row.statusText}</strong><#if row.needsReply> · <span class="error">Needs your reply</span></#if></p><p><small>Case ${row.requestId}<#if (view.customers.length > 1)> · ${row.customerName}</#if> · opened ${row.createdText} · updated ${row.updatedText}</small></p></article></#list></section>
<#if nextHref || firstHref><nav class="card" aria-label="More cases"><#if firstHref><a href="${firstHref}">Newest cases</a> </#if><#if nextHref><a href="${nextHref}" id="MyCasesMore">Older cases</a></#if></nav></#if></#if>
