<#if failure><h1>Your feedback</h1><p role="alert" class="error">${failure.message}</p>
<#else><#assign inv = view.invitation><h1>${inv.title}</h1>
<p>${inv.organizationName} asks ${inv.customerName} about a request it handled for you.</p>
<#if feedbackError><p role="alert" class="error">${feedbackError}</p></#if>
<#if view.receipt><section class="card" id="FeedbackReceipt" aria-live="polite"><h2>Thank you</h2><p>${view.receipt.message}</p><dl><dt>Answered</dt><dd>${view.receipt.submittedText}</dd><#if view.receipt.scoreText><dt>Your rating</dt><dd>${view.receipt.scoreText}</dd></#if></dl></section></#if>
<#if view.capabilities.canSubmit><form method="post" id="CaseFeedback" class="card" action="${publicPath}/submit"><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="token" value="${token}"><input type="hidden" name="operationId" value="${submitOperationId}"><input type="hidden" name="fieldNames" value="${fieldNames}">
<#list feedbackFields as f><div class="field" id="field_${f.fieldName}"<#if f.showText> data-visible-when="${f.showText}"</#if><#if f.requireText> data-require-when="${f.requireText}"</#if>>
<#if f.kind == 'radio'><fieldset><legend>${f.title}<#if f.required> <span aria-hidden="true">*</span></#if></legend><#list f.options as o><label><input type="radio" name="${f.fieldName}" value="${o.key}"<#if f.required> required</#if>> ${o.text}</label></#list></fieldset>
<#elseif f.kind == 'checks'><fieldset><legend>${f.title}</legend><#list f.options as o><label><input type="checkbox" name="${f.fieldName}" value="${o.key}"> ${o.text}</label></#list></fieldset>
<#elseif f.kind == 'select'><label>${f.title}<#if f.required> <span aria-hidden="true">*</span></#if> <select name="${f.fieldName}"<#if f.required> required</#if>><option value=""></option><#list f.options as o><option value="${o.key}">${o.text}</option></#list></select></label>
<#elseif f.kind == 'textarea'><label>${f.title}<#if f.required> <span aria-hidden="true">*</span></#if> <textarea name="${f.fieldName}" rows="4" maxlength="4000"<#if f.required> required</#if>></textarea></label>
<#elseif f.kind == 'date'><label>${f.title}<#if f.required> <span aria-hidden="true">*</span></#if> <input type="date" name="${f.fieldName}"<#if f.required> required</#if>></label>
<#else><label>${f.title}<#if f.required> <span aria-hidden="true">*</span></#if> <input name="${f.fieldName}" maxlength="255"<#if f.required> required</#if>></label></#if>
<#if f.tooltip><p><small>${f.tooltip}</small></p></#if></div></#list>
<p><button>Send my answer</button></p><p><small>You can answer once. The link works until ${inv.expiresText}.</small></p></form><script src="/js/moqui-form-when.js"></script></#if></#if>
