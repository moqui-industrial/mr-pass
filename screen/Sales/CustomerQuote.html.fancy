<#if failure><h1>Your quote</h1><p role="alert" class="error">${failure.message}</p><#if failure.kind == 'AuthenticationRequired'><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath + '?' + quoteQuery)}">Sign in</a></p></#if>
<#else><#assign q = view.quote><h1>Quote ${q.orderId}<#if q.name> · ${q.name}</#if></h1>
<#if flash.notice><p role="status" class="card">${flash.notice}</p></#if><#if flash.error><p role="alert" class="error" id="QuoteError">${flash.error}</p><#if flash.reason == 'acceptanceSignInRequired' || flash.reason == 'signInRequired'><p><a href="${signInHref}">Sign in</a></p></#if></#if>
<section class="card" id="QuoteOffer"><p><strong>${q.stateText}</strong></p><dl><dt>From</dt><dd>${q.sellerName}<#if q.repName> · ${q.repName}</#if></dd><dt>For</dt><dd>${q.customerName}</dd><dt>Revision</dt><dd>${q.revision}</dd><dt>Issued</dt><dd>${q.issuedText}</dd><dt>Valid through</dt><dd>${q.validThruText}</dd><#if q.yourReference><dt>Your reference</dt><dd>${q.yourReference}</dd></#if></dl>
<div class="table-wrap"><table class="lines"><thead><tr><th scope="col">Item</th><th scope="col">Quantity</th><th scope="col">Price</th><th scope="col">Amount</th></tr></thead><tbody>
<#list q.lines as l><tr><td class="wrap">${l.productText}<#if l.description><br><small>${l.description}</small></#if></td><td>${l.quantityText}</td><td>${l.priceText}</td><td>${l.amountText}</td></tr></#list></tbody></table></div>
<dl><dt>Products</dt><dd>${q.productsText}</dd><#if q.shippingText><dt>Shipping</dt><dd>${q.shippingText}</dd></#if><#if q.taxText><dt>Tax</dt><dd>${q.taxText}</dd></#if><dt>Total</dt><dd><strong>${q.totalText}</strong> ${q.currencyUomId}</dd></dl>
<#if view.document><p><a href="${publicPath}/document?${quoteQuery}" id="QuoteDocument">Download the quote (PDF): ${view.document.fileName}</a></p></#if>
<#if q.termsText><h2>Terms</h2><p class="wrap">${q.termsText}</p></#if></section>
<#if view.response><section class="card" id="QuoteAnswered"><h2>${view.response.responseText}</h2><p>${view.response.message}</p><p><a href="${passBases.sales}/QuoteResponse?${quoteQuery}">See the receipt</a></p></section></#if>
<#if view.capabilities.signInToAccept><section class="card" id="QuoteSignIn"><h2>Accept this quote</h2><p>To accept a quote of this amount, sign in as a contact invited for ${q.customerName}. You can still decline it here.</p><p><a href="${signInHref}">Sign in to accept</a></p></section></#if>
<#if view.capabilities.canAccept><form method="post" id="AcceptQuote" class="card" action="${publicPath}/respond"><h2>Accept this quote</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="operationId" value="${respondOperationId}"><input type="hidden" name="action" value="accept"><input type="hidden" name="expectedRevision" value="${q.revision}"><#if token><input type="hidden" name="token" value="${token}"><#else><input type="hidden" name="orderId" value="${q.orderId}"></#if>
<p>You accept the whole quote ${q.orderId}, revision ${q.revision}, for <strong>${q.totalText}</strong> ${q.currencyUomId}. The offer cannot be changed here; to change it, ask ${q.repName || q.sellerName} for a new quote.</p>
<label>Your purchase order number<#if view.capabilities.poRequired> <span aria-hidden="true">*</span></#if> <input name="purchaseOrder" maxlength="60"<#if view.capabilities.poRequired> required</#if>></label>
<label>Your name <input name="acceptorName" maxlength="120" required autocomplete="name"></label><label>Your title <input name="acceptorTitle" maxlength="120" autocomplete="organization-title"></label>
<label><input type="checkbox" name="acknowledge" value="Y" required> I accept this quote and its terms for ${q.customerName}</label><p><button>Accept the quote</button></p></form></#if>
<#if view.capabilities.canDecline><form method="post" id="DeclineQuote" class="card" action="${publicPath}/respond"><h2>Decline this quote</h2><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="operationId" value="${declineOperationId}"><input type="hidden" name="action" value="decline"><#if token><input type="hidden" name="token" value="${token}"><#else><input type="hidden" name="orderId" value="${q.orderId}"></#if>
<label>Why (so we can do better) <textarea name="reason" rows="3" maxlength="2000" required></textarea></label><p><button>Decline the quote</button></p></form></#if></#if>
