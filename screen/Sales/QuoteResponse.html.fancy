<#if failure><h1>Your response</h1><p role="alert" class="error">${failure.message}</p><#if failure.kind == 'AuthenticationRequired'><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath + '?' + quoteQuery)}">Sign in</a></p></#if>
<#else><#assign q = view.quote><#assign r = view.response><h1>${r.accepted ? 'Quote accepted' : 'Quote declined'}</h1>
<#if flash.notice><p role="status" class="card">${flash.notice}</p></#if>
<section class="card" id="ResponseReceipt" aria-live="polite"><p><strong>${r.message}</strong></p><dl><dt>Quote</dt><dd>${q.orderId}<#if q.name> · ${q.name}</#if>, revision ${q.revision}</dd><dt>From</dt><dd>${q.sellerName}</dd><dt>For</dt><dd>${q.customerName}</dd><dt>Total</dt><dd>${q.totalText} ${q.currencyUomId}</dd><dt>${r.responseText}</dt><dd>${r.respondedText} · ${r.byText}</dd>
<#if r.acceptorName><dt>By</dt><dd>${r.acceptorName}<#if r.acceptorTitle>, ${r.acceptorTitle}</#if></dd></#if><#if r.purchaseOrder><dt>Your purchase order</dt><dd>${r.purchaseOrder}</dd></#if><#if r.orderId><dt>Order</dt><dd>${r.orderId}</dd></#if><#if r.reason><dt>Your reason</dt><dd class="wrap">${r.reason}</dd></#if></dl>
<#if view.document><p><a href="${passBases.sales}/CustomerQuote/document?${quoteQuery}">Download the quote (PDF): ${view.document.fileName}</a></p></#if>
<p>Questions? Contact ${q.repName || q.sellerName}.</p></section></#if>
