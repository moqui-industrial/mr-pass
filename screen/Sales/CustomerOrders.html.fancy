<h1>My orders</h1>
<#if !siteInfo.authenticated><p>Sign in to see your company's orders with us. The link in our order confirmation opens that order without signing in.</p><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath || '')}">Sign in</a></p>
<#elseif failure><p role="alert" class="error">${failure.message}</p>
<#else><form method="get" id="MyOrderFind" class="card" role="search" action="${publicPath}"><label>Show <select name="state"><option value="all"<#if state == 'all'> selected</#if>>All</option><option value="open"<#if state == 'open'> selected</#if>>Open</option></select></label> <label>Order or your PO <input name="reference" maxlength="60" value="${reference}"></label><button>Find</button></form>
<section id="MyOrders" aria-label="Orders"><#if !view.actingFor><p class="card">Your account is not a contact of a customer here. Ask your sales contact for an invitation.</p><#elseif !view.orderList.length><p class="card">No orders to show.</p></#if>
<#list view.orderList as row><article class="card"><h2><a href="${passBases.sales}/CustomerOrder?orderId=${encodeURIComponent(row.orderId)}">Order ${row.orderId}<#if row.name> · ${row.name}</#if></a></h2><p><strong>${row.stateText}</strong> · ${row.totalText}</p><p><small><#if row.customerName>${row.customerName} · </#if>placed ${row.placedText}<#if row.purchaseOrder> · your PO ${row.purchaseOrder}</#if></small></p><p><small>${row.deliveryText} · ${row.billingText}</small></p></article></#list></section>
<#if nextHref || firstHref><nav class="card" aria-label="More orders"><#if firstHref><a href="${firstHref}">Newest orders</a> </#if><#if nextHref><a href="${nextHref}" id="MyOrdersMore">Older orders</a></#if></nav></#if></#if>
