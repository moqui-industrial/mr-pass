<#if failure><h1>Your order</h1><p role="alert" class="error">${failure.message}</p><#if failure.kind == 'AuthenticationRequired'><p><a href="${passBases.account}/Login?returnTo=${encodeURIComponent(publicPath + '?' + orderQuery)}">Sign in</a></p></#if>
<#else><#assign o = view.order><h1>Order ${o.orderId}<#if o.name> · ${o.name}</#if></h1>
<#if flash.error><p role="alert" class="error">${flash.error}</p></#if>
<section class="card" id="OrderSummary"><p role="status"><strong>${o.stateText}</strong><#if o.cancelled> · this order was cancelled and can no longer be changed</#if></p><dl><dt>From</dt><dd>${o.sellerName}<#if o.repName> · ${o.repName}</#if></dd><dt>For</dt><dd>${o.customerName}</dd><dt>Placed</dt><dd>${o.placedText}</dd><#if o.purchaseOrder><dt>Your purchase order</dt><dd>${o.purchaseOrder}</dd></#if><#if o.shipByText><dt>Ships by</dt><dd>${o.shipByText}</dd></#if><#if o.deliveryByText><dt>Delivery by</dt><dd>${o.deliveryByText}</dd></#if>
<#if view.acceptedQuote><dt>From quote</dt><dd><#if view.capabilities.quoteLink><a href="${passBases.sales}/CustomerQuote?orderId=${encodeURIComponent(view.acceptedQuote.orderId)}">Quote ${view.acceptedQuote.orderId}</a><#else>Quote ${view.acceptedQuote.orderId}</#if>, revision ${view.acceptedQuote.revision}, accepted ${view.acceptedQuote.acceptedText}</dd></#if></dl>
<div class="table-wrap"><table class="lines"><thead><tr><th scope="col">Item</th><th scope="col">Quantity</th><th scope="col">Price</th><th scope="col">Amount</th></tr></thead><tbody>
<#list o.lines as l><tr><td class="wrap">${l.productText}<#if l.description><br><small>${l.description}</small></#if><#if l.promisedText><br><small>Needed by ${l.promisedText}</small></#if></td><td>${l.quantityText}</td><td>${l.priceText}</td><td>${l.amountText}</td></tr></#list></tbody></table></div>
<dl><dt>Products</dt><dd>${o.productsText}</dd><#if o.shippingText><dt>Shipping</dt><dd>${o.shippingText}</dd></#if><#if o.taxText><dt>Tax</dt><dd>${o.taxText}</dd></#if><dt>Total</dt><dd><strong>${o.totalText}</strong> ${o.currencyUomId}</dd></dl>
<#if view.document><p><a href="${publicPath}/document?${orderQuery}" id="OrderDocument">Download the order confirmation (PDF): ${view.document.fileName}</a></p></#if></section>
<section class="card" id="OrderShipments"><h2>Delivery</h2><#if !view.shipments.length><p>Nothing has shipped yet.</p></#if><#list view.shipments as s><article><p><strong>${s.statusText}</strong><#if s.shippedText> · shipped ${s.shippedText}</#if><#if s.arrivalText> · expected ${s.arrivalText}</#if><#if s.carrierText> · ${s.carrierText}</#if></p><#if s.tracking.length><p>Tracking <#list s.tracking as t><#if t.url><a href="${t.url}" rel="noopener noreferrer" target="_blank">${t.code}</a><#else>${t.code}</#if> </#list></p></#if><#if s.items.length><ul><#list s.items as i><li>${i.productText} × ${i.quantityText}</li></#list></ul></#if></article></#list></section>
<section class="card" id="OrderInvoices"><h2>Invoices</h2><#if !view.invoices.length><p>No invoice yet.</p></#if><#list view.invoices as i><article><p><strong>Invoice ${i.invoiceId}</strong> · ${i.invoiceDateText}<#if i.dueText> · due ${i.dueText}</#if> · ${i.totalText}</p><p><#if i.paid>Paid<#else>Open: ${i.openText}</#if><#if i.billingUrl> · <a href="${i.billingUrl}">Open in Billing</a></#if></p></article></#list></section>
<#assign a = view.actions><#if a.askUrl || a.requestCancelUrl || a.requestReturnUrl || a.cancellationRequested><nav class="card" id="OrderHelp" aria-label="Help with this order"><h2>Help with this order</h2><p><#if a.askUrl><a href="${a.askUrl}"><#if o.cancelled>Ask about this order<#else>Ask about or change this order</#if></a></#if><#if a.requestCancelUrl> · <a href="${a.requestCancelUrl}">Request cancellation</a></#if><#if a.requestReturnUrl> · <a href="${a.requestReturnUrl}">Request a return</a></#if><#if a.cancellationRequested> · <strong>Cancellation requested</strong></#if></p></nav></#if>
<p>Questions? Contact ${o.repName || o.sellerName}.</p></#if>
