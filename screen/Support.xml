<!-- Support: a customer's pages for the service organization the site's support mount targets (Customer Service; mr-mantle
    mantle.request.CaseFeedbackServices, and from P15 SupportCaseServices' customer services; impl-customer-service P13,
    P15). Feedback, which a resolved case's feedback invitation opens with its token, is the first page; P15 adds the help,
    cases and returns pages. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Support">
  <always-actions>
    <set field="passApp" value="support"/>
  </always-actions>
  <subscreens default-item="Feedback"/>
  <widgets>
    <subscreens-active/>
  </widgets>
</screen>
