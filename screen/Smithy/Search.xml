<!-- Search (design-smithy §6 Search, §13.5), at /search?q=: one box over the public projections (searchSite: repositories,
    groups, components, issues, merge requests, docs and forum topics, each kept by its own rule), the kinds as a filter,
    narrowed to a group or a repository by ?in=<path>; several kinds give ten results each, one kind is paged. Never kept
    by a cache (Shared/Headers.js). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Search">
  <actions>
    <script><![CDATA[
        smithyHome=false
        view=ec.resource.script('component://mr-pass/screen/Smithy/SmithySite.js').search(resolvedSiteId,passBases,siteInfo,String(publicPath || ''))
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html"><![CDATA[${raw(view.html)}]]></text>
    </render-mode>
  </widgets>
</screen>
