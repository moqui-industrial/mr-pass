<h2>${refTitle}</h2>
<#if refForms.confirmHtml>${raw(refForms.confirmHtml)}<#else>
<section id="SmithyRefList" aria-label="${refTitle}"><#if !view.rows.length><p class="card">None to show.</p></#if>
<#list view.rows as row><article class="card smithy-row"><h3 class="wrap"><a href="${row.href}">${row.name}</a><#if row.isDefault> <small class="smithy-chip">Default</small></#if><#if row.protected> <small class="smithy-chip">Protected</small></#if></h3><p class="wrap"><small><#if row.commitHref><a href="${row.commitHref}"><code>${row.shortId}</code></a> </#if>${row.summary}<#if row.date> · ${row.date}</#if><#if row.compareHref && row.ahead != null> · ${row.ahead} ahead, ${row.behind || 0} behind</#if><#if row.compareHref> · <a href="${row.compareHref}">Compare</a></#if><#if row.archives><#list row.archives as archive> · <a href="${archive.href}" rel="nofollow" aria-label="Download ${row.name} as ${archive.label}">${archive.label}</a></#list></#if><#if row.deleteHref> · <a href="${row.deleteHref}" aria-label="Delete ${row.name}">Delete</a></#if></small></p></article></#list></section>
<#if view.moreHref><p><a href="${view.moreHref}">More</a></p></#if>
${raw(refForms.createHtml)}</#if>
