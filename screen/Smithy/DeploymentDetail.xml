<!-- DeploymentDetail (design-smithy §10 Deploy environments, DG10), at -/pipelines/deployments/<deploymentId>, in its
    repository's shell: a deployment (getDeployment) with its steps (waiting for the pipeline, with the run linked; waiting
    for approval; deploying; the end), who asked and who decided, and the target's result; Approve and Refuse (with a
    reason, asked again on ?confirm=refuse) for an approver, Cancel (asked again on ?confirm=cancel) for who may cancel it,
    each a post to Smithy/Do. A deployment the caller may not read is Not Found. Never kept by a cache. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Deployment">
  <parameter name="repositoryId"/>
  <parameter name="namePath"/>
  <parameter name="deploymentId"/>
  <pre-actions>
    <script><![CDATA[
        // read before anything renders, so a deployment the caller may not read is the framework's Not Found, not a part of the shell
        smithyRepository=ec.resource.script('component://mr-pass/screen/Smithy/Smithy.js').repositoryShell(resolvedSiteId,String(repositoryId || ''),passBases.smithy,String(publicPath || ''))
        smithyDeployment=ec.resource.script('component://mr-pass/screen/Smithy/SmithyPipelines.js').deploymentPage(smithyRepository,String(deploymentId || ''),passBases,siteInfo,String(publicPath || ''))
    ]]></script>
  </pre-actions>
  <actions>
    <script><![CDATA[
        view=smithyDeployment
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Smithy/RepositoryShell.html.fancy"/>
    </render-mode>
    <render-mode>
      <text type="html"><![CDATA[${raw(view.html)}]]></text>
    </render-mode>
  </widgets>
</screen>
