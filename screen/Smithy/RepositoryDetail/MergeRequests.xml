<!-- MergeRequests (design-smithy §9 MergeRequests), at -/merge-requests: a repository's merge requests, open, merged or closed
    with their counts, filtered by author, reviewer, target branch, draft and text in a GET form, by cursor
    (findMergeRequests). One held for review is listed for its author alone. Not Found where merge requests are off. Never
    kept by a cache. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Merge requests">
  <actions>
    <script><![CDATA[
        view=ec.resource.script('component://mr-pass/screen/Smithy/SmithyReview.js').mergeRequests(smithyRepository,passBases,siteInfo,String(publicPath || ''))
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html"><![CDATA[${raw(view.html)}]]></text>
    </render-mode>
  </widgets>
</screen>
