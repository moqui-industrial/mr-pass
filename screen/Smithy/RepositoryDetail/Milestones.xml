<!-- Milestones (design-smithy §8 Milestones), at -/milestones and -/milestones/<milestoneId>: open and closed milestones with
    the due date and the share of closed issues (findMilestones), and one milestone with its issues (findIssues). A
    Maintainer makes, changes and closes one (storeMilestone); the forms post to Smithy/Do. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Milestones">
  <parameter name="milestoneId"/>
  <actions>
    <script><![CDATA[
        view=ec.resource.script('component://mr-pass/screen/Smithy/SmithyIssues.js').milestones(smithyRepository,String(milestoneId || ''),passBases,siteInfo,String(publicPath || ''))
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html"><![CDATA[${raw(view.html)}]]></text>
    </render-mode>
  </widgets>
</screen>
