<!-- Tags (design-smithy §7 Tags): the tags with their commit (findRefs, refType tag). A Developer creates a tag (createRef) and a
    Maintainer deletes one after confirming (deleteRef); those forms post to Smithy/Do. Releases and downloads come in DG7. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Tags">
  <actions>
    <script><![CDATA[
        view=ec.resource.script('component://mr-pass/screen/Smithy/Smithy.js').refs(smithyRepository,'tag')
        refTitle='Tags'
        refForms=ec.resource.script('component://mr-pass/screen/Smithy/SmithyForms.js').refForms(smithyRepository,'tag',view,passBases,siteInfo)
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Smithy/Refs.html.fancy"/>
    </render-mode>
  </widgets>
</screen>
