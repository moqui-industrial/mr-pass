<!-- Issues (design-smithy §8 Issues), at -/issues: a repository's issues, open or closed with their counts, filtered by label,
    milestone, assignee, author and text in a GET form, by cursor (findIssues, findLabels, findMilestones). An Owner has a
    Confidential filter; nobody else sees that it exists. Not Found where issues are off. Never kept by a cache. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Issues">
  <actions>
    <script><![CDATA[
        view=ec.resource.script('component://mr-pass/screen/Smithy/SmithyIssues.js').issues(smithyRepository,passBases,siteInfo,String(publicPath || ''))
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html"><![CDATA[${raw(view.html)}]]></text>
    </render-mode>
  </widgets>
</screen>
