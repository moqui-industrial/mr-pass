<!-- Fork (design-smithy §9 Fork), at -/fork and -/forks: the form that forks the repository into the caller's namespace or a
    group where it may create (forkRepository; the page names the source and is the confirmation), and the repository's
    forks the caller may view (findForks). A visitor is sent to sign in. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Fork">
  <actions>
    <script><![CDATA[
        view=ec.resource.script('component://mr-pass/screen/Smithy/SmithyReview.js').fork(smithyRepository,passBases,siteInfo,String(publicPath || ''))
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html"><![CDATA[${raw(view.html)}]]></text>
    </render-mode>
  </widgets>
</screen>
