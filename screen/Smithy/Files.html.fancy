<#if view.empty><section class="card" id="SmithyEmpty"><h2>This repository is empty</h2><p>Push a first commit to one of its addresses:</p><#list smithyRepository.cloneUrls as clone><p>${clone.label}</p><pre class="smithy-code">git remote add origin ${clone.url}
git push -u origin main</pre></#list></section>
<#else><form method="get" action="${view.pickerAction}" class="card" id="SmithyRefPicker"><label>Branch or tag <select name="ref"><#if !view.choices.branches.includes(view.ref) && !view.choices.tags.includes(view.ref)><option value="${view.ref}" selected>${view.ref}</option></#if><optgroup label="Branches"><#list view.choices.branches as name><option value="${name}"<#if name == view.ref> selected</#if>>${name}</option></#list></optgroup><#if view.choices.tags.length><optgroup label="Tags"><#list view.choices.tags as name><option value="${name}"<#if name == view.ref && !view.choices.branches.includes(name)> selected</#if>>${name}</option></#list></optgroup></#if></select></label><input type="hidden" name="path" value="${view.path}"><button>Go</button></form>
<nav aria-label="Path" class="smithy-crumbs"><#list view.crumbs as crumb><#if crumb_index><span aria-hidden="true">/</span></#if><#if crumb.href><a href="${crumb.href}">${crumb.label}</a><#else><strong>${crumb.label}</strong></#if></#list></nav>
<#if view.lastCommit><p class="card wrap" id="SmithyLastCommit"><a href="${view.lastCommit.href}">${view.lastCommit.summary}</a> · ${view.lastCommit.authorName} · ${view.lastCommit.date} · <a href="${view.lastCommit.href}"><code>${view.lastCommit.shortId}</code></a> · <a href="${view.historyHref}">History</a></p><#else><p><a href="${view.historyHref}">History</a></p></#if>
<div class="card table-wrap"><table class="lines" id="SmithyTree"><thead><tr><th scope="col">Name</th><th scope="col" class="smithy-wide">Last commit</th><th scope="col" class="smithy-wide">Size</th><th scope="col">Date</th></tr></thead><tbody>
<#if view.parentHref><tr><td colspan="4"><a href="${view.parentHref}" aria-label="Parent directory">..</a></td></tr></#if>
<#list view.entries as entry><tr><td class="wrap"><#if entry.href><a href="${entry.href}">${entry.name}<#if entry.directory>/</#if></a><#else>${entry.name} <small>(submodule)</small></#if></td><td class="smithy-wide wrap"><#if entry.commitHref><a href="${entry.commitHref}">${entry.summary}</a><#else>${entry.summary}</#if></td><td class="smithy-wide">${entry.size}</td><td>${entry.date}</td></tr></#list>
<#if !view.entries.length><tr><td colspan="4">This directory is empty.</td></tr></#if></tbody></table></div>
<#if view.moreHref><p><a href="${view.moreHref}">Show more</a></p></#if>
<#if view.readme><article id="SmithyReadme" class="wrap"><h2>${view.readme.path}</h2>${raw(view.readme.html)}</article></#if></#if>
