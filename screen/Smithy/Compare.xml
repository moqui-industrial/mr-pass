<!-- Compare (design-smithy §7 Compare): two refs of a repository (getCompare): ahead and behind, whether it merges cleanly, the
    commits and the diff; the two refs are a GET form whose choice is redirected to -/compare/<base>...<head>. Opening a merge
    request comes in DG4. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Compare">
  <parameter name="repositoryId"/>
  <parameter name="namePath"/>
  <parameter name="base"/>
  <parameter name="head"/>
  <parameter name="headRepositoryPath"/>
  <actions>
    <script><![CDATA[
        const smithy=ec.resource.script('component://mr-pass/screen/Smithy/Smithy.js')
        smithyRepository=smithy.repositoryShell(resolvedSiteId,String(repositoryId || ''),passBases.smithy,String(publicPath || ''))
        // base and head are the resolver's (the path); the form's fields are from and to, read in compare()
        view=smithy.compare(smithyRepository,String(base || ''),String(head || ''),String(headRepositoryPath || ''))
        if(view.redirect)sri.sendRedirectAndStopRender(view.redirect)
        changes=view.result
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Smithy/RepositoryShell.html.fancy"/>
    </render-mode>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Smithy/Compare.html.fancy"/>
    </render-mode>
    <section name="SmithyCompareChanges" condition="!!changes">
      <widgets>
        <render-mode>
          <text type="html" location="component://mr-pass/screen/Smithy/Changes.html.fancy"/>
        </render-mode>
      </widgets>
    </section>
  </widgets>
</screen>
