<!-- NewIssue (design-smithy §8 NewIssue), at -/issues/new, in its repository's shell: title, text (a Markdown textarea with a
    server preview; the composer's island where JavaScript runs), the Confidential mark with who will read it, and for a
    Reporter labels, assignees and milestone. The form posts to Smithy/Do (createIssue, previewPost). A visitor is sent to
    sign in, and an account without a confirmed address is told to confirm it. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="New issue">
  <parameter name="repositoryId"/>
  <parameter name="namePath"/>
  <actions>
    <script><![CDATA[
        smithyRepository=ec.resource.script('component://mr-pass/screen/Smithy/Smithy.js').repositoryShell(resolvedSiteId,String(repositoryId || ''),passBases.smithy,String(publicPath || ''))
        view=ec.resource.script('component://mr-pass/screen/Smithy/SmithyIssues.js').newIssue(smithyRepository,passBases,siteInfo,String(publicPath || ''))
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Smithy/RepositoryShell.html.fancy"/>
    </render-mode>
    <render-mode>
      <text type="html"><![CDATA[${raw(view.html)}]]></text>
    </render-mode>
  </widgets>
</screen>
