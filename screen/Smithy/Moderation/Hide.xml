<!-- Hide (design-smithy §12.3), at -/moderation/hide of a group or a repository, in its shell (Smithy/Moderation):
    Smithy/SmithyScope.js hide builds the page, whose form posts to Smithy/Do. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Hide">
  <pre-actions>
    <script><![CDATA[
        // built before anything renders, so who may not see the page gets the framework's Not Found, not a part of the shell
        smithyHide=ec.resource.script('component://mr-pass/screen/Smithy/SmithyScope.js').hide(smithyModeration,passBases,siteInfo,String(publicPath || ''))
    ]]></script>
  </pre-actions>
  <actions>
    <script><![CDATA[
        view=smithyHide
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html"><![CDATA[${raw(view.html)}]]></text>
    </render-mode>
  </widgets>
</screen>
