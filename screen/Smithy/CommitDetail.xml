<!-- CommitDetail (design-smithy §7 CommitDetail): a commit (getCommit) in its repository's shell: message, author and committer,
    parents, its statuses, the issues it names (those the caller may see; any other only in a count), the file list with
    counts, and the diff rendered on the server as unified text. A commit of a repository the caller may not view, and an id it does not have, are Not Found. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Commit">
  <parameter name="repositoryId"/>
  <parameter name="namePath"/>
  <parameter name="commitId"/>
  <actions>
    <script><![CDATA[
        const smithy=ec.resource.script('component://mr-pass/screen/Smithy/Smithy.js')
        smithyRepository=smithy.repositoryShell(resolvedSiteId,String(repositoryId || ''),passBases.smithy,String(publicPath || ''))
        view=smithy.commit(smithyRepository,String(commitId || ''))
        changes=view
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Smithy/RepositoryShell.html.fancy"/>
    </render-mode>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Smithy/CommitDetail.html.fancy"/>
    </render-mode>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Smithy/Changes.html.fancy"/>
    </render-mode>
  </widgets>
</screen>
