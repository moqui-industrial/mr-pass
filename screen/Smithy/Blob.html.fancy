<nav aria-label="Path" class="smithy-crumbs"><#list view.crumbs as crumb><#if crumb_index><span aria-hidden="true">/</span></#if><#if crumb.href><a href="${crumb.href}">${crumb.label}</a><#else><strong>${crumb.label}</strong></#if></#list></nav>
<p class="card wrap" id="SmithyBlobHeader"><strong>${view.name}</strong> · ${view.size}<#if view.lastCommit> · <a href="${view.lastCommit.href}">${view.lastCommit.summary}</a> · ${view.lastCommit.date}</#if> · <a href="${view.rawHref}">Raw</a> · <a href="${view.historyHref}">History</a><#if view.permalink> · <a href="${view.permalink}">Permalink</a></#if><#if view.hasRendered> · <#if view.plain><a href="${view.renderedHref}">Rendered</a><#else><a href="${view.sourceHref}">Source</a></#if></#if></p>
<#if view.html><article id="SmithyRendered" class="wrap">${raw(view.html)}</article>
<#elseif view.codeHtml><pre class="card smithy-code" id="SmithyCode"><code>${raw(view.codeHtml)}</code></pre>
<#elseif view.image><p class="card"><img src="${view.rawHref}" alt="${view.name}"></p>
<#elseif view.tooLarge><p class="card">This file is too large to show here. <a href="${view.rawHref}">Download it (${view.size})</a>.</p>
<#else><p class="card">${view.lfs ? 'This file is kept in Git LFS.' : 'This is a binary file.'} <a href="${view.rawHref}">Download it (${view.size})</a>.</p></#if>
