<h2 class="wrap">Commits<#if view.ref> on ${view.ref}</#if><#if view.path> in ${view.path}</#if></h2>
<p><a href="${view.treeHref}">Browse files</a><#if view.newestHref> · <a href="${view.newestHref}">Newest</a></#if></p>
<section id="SmithyCommitList" aria-label="Commits"><#if !view.days.length><p class="card">No commits to show.</p></#if>
<#list view.days as day><h3>${day.date}</h3><#list day.commits as row><article class="card smithy-row"><p class="wrap"><a href="${row.href}">${row.summary || row.shortId}</a></p><p><small>${row.authorName}<#if row.authorHref> <a href="${row.authorHref}">@${row.authorHandle}</a></#if> · <a href="${row.href}"><code>${row.shortId}</code></a></small></p></article></#list></#list></section>
<#if view.olderHref><p><a href="${view.olderHref}" id="SmithyCommitsOlder">Older</a></p></#if>
