<h2>Compare</h2>
<form method="get" action="${view.action}" class="card" id="SmithyCompareForm"><label>Base <input name="from" value="${view.base}" maxlength="250" required></label><label>Compare <input name="to" value="${view.head}" maxlength="250" required></label><button>Compare</button></form>
<p><small>A fork's branch is written <code>group/repository:branch</code>.<#if view.parent> This repository is a fork: <a href="${view.parent.href}" id="SmithyCompareParent">compare with ${view.parent.path}</a>.</#if></small></p>
<#if view.failure><p role="alert" class="error">${view.failure}</p></#if>
<#if view.result><p class="card" id="SmithyCompareSummary">${view.result.aheadBy} ahead, ${view.result.behindBy} behind<#if view.result.mergeable == true> · merges cleanly<#elseif view.result.mergeable == false> · conflicts<#if view.result.conflictPaths.length> in ${view.result.conflictPaths.join(', ')}</#if></#if></p>
<#if view.openHref><p id="SmithyOpenMergeRequest"><a href="${view.openHref}">Open a merge request</a></p></#if>
<section id="SmithyCompareCommits" aria-label="Commits"><h2>Commits</h2><#if !view.result.commits.length><p class="card">No commits to show.</p></#if><#list view.result.commits as row><article class="card smithy-row"><p class="wrap"><a href="${row.href}">${row.summary || row.shortId}</a></p><p><small>${row.authorName}<#if row.authorHref> <a href="${row.authorHref}">@${row.authorHandle}</a></#if> · ${row.date} · <a href="${row.href}"><code>${row.shortId}</code></a></small></p></article></#list><#if view.result.commitsTruncated><p>Only the first commits are listed.</p></#if></section></#if>
