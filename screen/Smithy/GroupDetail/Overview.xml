<!-- GroupOverview (design-smithy §6 GroupOverview, §13.1): the group's landing text (getGroupLanding: a Markdown page of a
    content repository, its links made that repository's pages), else its description; its pinned repositories, the latest
    release, news and activity (getGroupLanding), and its subgroups (findGroups). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        require-authentication="false" default-menu-title="Overview">
  <actions>
    <script><![CDATA[
        overviewView=ec.resource.script('component://mr-pass/screen/Smithy/Smithy.js').overview(resolvedSiteId,smithyGroup,passBases.smithy)
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Smithy/GroupOverview.html.fancy"/>
    </render-mode>
  </widgets>
</screen>
