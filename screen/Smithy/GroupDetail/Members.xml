<!-- GroupMembers (design-smithy §6 GroupMembers): the members the caller may see with their roles (findGroupMembers). An Owner
    adds a member by handle, changes a role and removes one (setGroupMember), and a member leaves (leaveGroup); those forms
    post to Smithy/Do. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Members">
  <actions>
    <script><![CDATA[
        view=ec.resource.script('component://mr-pass/screen/Smithy/Smithy.js').groupMembers(resolvedSiteId,smithyGroup,passBases.smithy)
        memberForms=ec.resource.script('component://mr-pass/screen/Smithy/SmithyForms.js').groupMembers(smithyGroup,view,passBases,siteInfo,String(publicPath || ''))
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Smithy/GroupMembers.html.fancy"/>
    </render-mode>
  </widgets>
</screen>
