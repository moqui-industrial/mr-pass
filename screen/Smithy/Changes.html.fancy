<section id="SmithyChanges" aria-label="Changed files"><div class="smithy-difftools"><h2>${changes.files.length} ${changes.files.length == 1 ? 'file' : 'files'} changed <small>+${changes.insertions} −${changes.deletions}</small></h2><nav aria-label="Diff view" class="smithy-seg"><a href="?"<#if !changes.split> aria-current="true"</#if>>Unified</a><a href="?view=split"<#if changes.split> aria-current="true"</#if>>Split</a></nav></div>
<#if changes.truncated><p class="card">This change is large; only part of its diff is shown.</p></#if>
<div class="smithy-review"><nav aria-label="Files" class="smithy-filetree"><ul class="card" id="SmithyFileList"><#list changes.files as file><li class="wrap"><a href="#${file.anchor}" title="${file.path}"><span class="st st-${file.status.toLowerCase()}" aria-hidden="true"></span>${file.path}</a> <small>${file.status}<#if file.oldPath> from ${file.oldPath}</#if> +${file.insertions} −${file.deletions}</small></li></#list></ul></nav>
<div class="smithy-filelist"><#list changes.files as file><section class="card smithy-file" id="${file.anchor}"><details open><summary><h3 class="wrap"><#if file.oldPath>${file.oldPath} → </#if>${file.path} <small>${file.status}</small> ${raw(file.statHtml)}<#if file.viewHref> <a class="smithy-viewfile" href="${file.viewHref}">View file</a></#if></h3></summary><#if file.diffHtml>${raw(file.diffHtml)}<#elseif file.binary><p>Binary file.</p><#else><p>No text changes to show.</p></#if></details></section></#list></div></div></section>
