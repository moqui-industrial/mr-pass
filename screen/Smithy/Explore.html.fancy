<h1>${smithyHome ? siteInfo.site.name : 'Explore'}</h1>
<form method="get" action="${exploreView.action}" class="card" role="search" id="SmithyExploreFind"><label>Search <input type="search" name="q" value="${exploreView.q}" maxlength="100"></label>
<label>Show <select name="kind"><option value="all"<#if exploreView.kind == 'all'> selected</#if>>Groups and repositories</option><option value="groups"<#if exploreView.kind == 'groups'> selected</#if>>Groups</option><option value="repositories"<#if exploreView.kind == 'repositories'> selected</#if>>Repositories</option></select></label><button>Find</button></form>
<#if exploreView.groups><section id="SmithyExploreGroups" aria-label="Groups"><h2>Groups</h2><#if !exploreView.groups.length><p class="card">No groups to show.</p></#if>
${raw(ec.resource.template('component://mr-pass/screen/Smithy/GroupRows.html.fancy', {rows: exploreView.groups}))}
<#if exploreView.moreGroupsHref><p><a href="${exploreView.moreGroupsHref}">More groups</a></p></#if></section></#if>
<#if exploreView.repositories><section id="SmithyExploreRepositories" aria-label="Repositories"><h2>Repositories</h2><#if !exploreView.repositories.length><p class="card">No repositories to show.</p></#if>
${raw(ec.resource.template('component://mr-pass/screen/Smithy/RepositoryRows.html.fancy', {rows: exploreView.repositories}))}
<#if exploreView.moreRepositoriesHref><p><a href="${exploreView.moreRepositoriesHref}">More repositories</a></p></#if></section></#if>
