<nav aria-label="Breadcrumb" class="smithy-crumbs"><#list smithyRepository.crumbs as crumb><#if crumb_index><span aria-hidden="true">/</span></#if><#if crumb.href><a href="${crumb.href}">${crumb.label}</a><#else><strong>${crumb.label}</strong></#if></#list></nav>
<h1 class="wrap">${smithyRepository.repository.name}<#if smithyRepository.visibility> <small class="smithy-chip">${smithyRepository.visibility}</small></#if><#if smithyRepository.repository.archived> <small class="smithy-chip">Archived</small></#if><#if smithyRepository.repository.mirror> <small class="smithy-chip">Mirror</small></#if><#if smithyRepository.hidden> <small class="smithy-chip" id="SmithyHidden">Hidden</small></#if></h1>
<#if smithyRepository.hidden><p role="status" class="card" id="SmithyHiddenNote">A moderator hid this repository: only its owners and the site's moderators see it, on its pages and in git, and everyone else gets Not Found.</p></#if>
<#if smithyRepository.repository.description><p>${smithyRepository.repository.description}</p></#if>
<#if smithyRepository.forkOf><p id="SmithyForkOf">Forked from <a href="${smithyRepository.forkOf.href}">${smithyRepository.forkOf.path}</a></p></#if>
<#if smithyRepository.forkHref || smithyRepository.forkCount><p id="SmithyForks"><#if smithyRepository.forkHref><a href="${smithyRepository.forkHref}">Fork</a></#if><#if smithyRepository.forkHref && smithyRepository.forkCount> · </#if><#if smithyRepository.forkCount><a href="${smithyRepository.forksHref}">${smithyRepository.forkCount} ${smithyRepository.forkCount == 1 ? 'fork' : 'forks'}</a></#if></p></#if>
<#if smithyRepository.cloneUrls.length><details class="card smithy-clone" id="SmithyClone"><summary>Clone</summary><#list smithyRepository.cloneUrls as clone><label>${clone.label} <input type="text" readonly value="${clone.url}" aria-label="${clone.label} clone address"></label></#list><#if smithyRepository.capabilities.signedIn><p><small>To push, or to read what is not public, add an SSH key or make an access token: <a href="${passBases.account}/GitAccess">Git access</a></small></p></#if></details></#if>
<nav aria-label="Repository sections" class="card smithy-tabs"><#list smithyRepository.tabs as tab><a href="${tab.href}"<#if tab.current> aria-current="page"</#if>>${tab.label}<#if tab.count != null> <small>${tab.count}</small></#if></a></#list></nav>
<#if smithyRepository.flash.notice><p role="status" class="card" id="SmithyNotice">${smithyRepository.flash.notice}</p></#if>
<#if smithyRepository.reportHref && smithyRepository.section != 'moderation'><p><small><a href="${smithyRepository.reportHref}" id="SmithyReport">Report this repository</a><#if smithyRepository.hideHref> · <a href="${smithyRepository.hideHref}" id="SmithyHideLink">${smithyRepository.hidden ? 'Show it again' : 'Hide it'}</a></#if></small></p></#if>
