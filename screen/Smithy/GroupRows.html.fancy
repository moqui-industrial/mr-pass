<#list rows as row><article class="card smithy-row"><h3><a href="${row.href}">${row.path}</a><#if row.visibility && row.visibility != 'public'> <small class="smithy-chip">${row.visibility}</small></#if></h3><#if row.description><p>${row.description}</p></#if><p><small><#if row.repositoryCount != null>${row.repositoryCount} ${row.repositoryCount == 1 ? 'repository' : 'repositories'}</#if><#if row.subgroupCount> · ${row.subgroupCount} ${row.subgroupCount == 1 ? 'subgroup' : 'subgroups'}</#if></small></p></article></#list>
