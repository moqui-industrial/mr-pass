<article id="SmithyCommit" class="wrap"><h2>${view.summary || view.shortId}</h2><#if view.body><pre class="smithy-pre">${view.body}</pre></#if>
<dl><dt>Author</dt><dd>${view.authorName}<#if view.authorHref> <a href="${view.authorHref}">@${view.authorHandle}</a></#if> · ${view.date}</dd><#if view.committerName><dt>Committer</dt><dd>${view.committerName} · ${view.commitDate}</dd></#if>
<dt>Commit</dt><dd><code>${view.commitId}</code> · <a href="${view.browseHref}">Browse files</a></dd>
<#if view.parents.length><dt>${view.parents.length == 1 ? 'Parent' : 'Parents'}</dt><dd><#list view.parents as parent><a href="${parent.href}"><code>${parent.shortId}</code></a> </#list></dd></#if><#if view.refs.length><dt>Contained in</dt><dd id="SmithyCommitRefs"><#list view.refs as ref><a href="${ref.href}">${ref.name}</a><#if ref.kind == 'tag'> <small>tag</small><#elseif ref.isDefault> <small>default</small></#if> </#list><#if view.refsTruncated><small>and more</small></#if></dd></#if></dl></article>
<#if view.mergeRequests.length><section class="card" id="SmithyCommitMergeRequests" aria-label="Merge requests"><h2>Merge requests</h2><#list view.mergeRequests as request><p class="wrap"><a href="${request.href}">!${request.number}</a><#if request.title> ${request.title}</#if><#if request.state> <small class="smithy-chip">${request.state}</small></#if></p></#list></section></#if>
<#if view.statuses.length><section class="card" id="SmithyStatuses" aria-label="Checks"><h2>Checks</h2><#list view.statuses as status><p><strong>${status.state}</strong> · <#if status.href><a href="${status.href}" rel="nofollow noopener">${status.context}</a><#else>${status.context}</#if><#if status.description> · ${status.description}</#if></p></#list></section></#if>
<#if view.issues.length || view.hiddenItemCount><section class="card" id="SmithyCommitIssues" aria-label="Linked issues"><h2>Issues</h2><#list view.issues as issue><p class="wrap"><a href="${issue.href}">#${issue.number}</a><#if issue.title> ${issue.title}</#if><#if issue.closed> <small class="smithy-chip">Closed</small></#if></p></#list><#if view.hiddenItemCount><p>${view.hiddenItemCount} ${view.hiddenItemCount == 1 ? 'item' : 'items'} not shown</p></#if></section></#if>
