<article id="SmithyCommit" class="wrap"><h2>${view.summary || view.shortId}</h2><#if view.body><pre class="smithy-pre">${view.body}</pre></#if>
<dl><dt>Author</dt><dd>${view.authorName} · ${view.date}</dd><#if view.committerName><dt>Committer</dt><dd>${view.committerName} · ${view.commitDate}</dd></#if>
<dt>Commit</dt><dd><code>${view.commitId}</code> · <a href="${view.browseHref}">Browse files</a></dd>
<#if view.parents.length><dt>${view.parents.length == 1 ? 'Parent' : 'Parents'}</dt><dd><#list view.parents as parent><a href="${parent.href}"><code>${parent.shortId}</code></a> </#list></dd></#if></dl></article>
<#if view.statuses.length><section class="card" id="SmithyStatuses" aria-label="Checks"><h2>Checks</h2><#list view.statuses as status><p><strong>${status.state}</strong> · <#if status.href><a href="${status.href}" rel="nofollow noopener">${status.context}</a><#else>${status.context}</#if><#if status.description> · ${status.description}</#if></p></#list></section></#if>
<#if view.hiddenItemCount><p>${view.hiddenItemCount} ${view.hiddenItemCount == 1 ? 'item' : 'items'} not shown</p></#if>
