<#list rows as row><article class="card smithy-row"><h3><a href="${row.href}">${row.path}</a><#if row.visibility && row.visibility != 'public'> <small class="smithy-chip">${row.visibility}</small></#if><#if row.archived> <small class="smithy-chip">Archived</small></#if><#if row.mirror> <small class="smithy-chip">Mirror</small></#if></h3><#if row.description><p>${row.description}</p></#if><p><small><#if row.forkOf>Fork of <a href="${row.forkOf.href}">${row.forkOf.path}</a> · </#if><#if row.pushed>Last push ${row.pushed}</#if><#if row.forkCount><#if row.pushed> · </#if>${row.forkCount} ${row.forkCount == 1 ? 'fork' : 'forks'}</#if></small></p></article></#list>
