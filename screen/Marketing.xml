<!-- PASS Marketing: an organization's public subscription pages for the organization the site's marketing mount targets
    (IronStone impl-marketing P7; design-marketing §13; mr-mantle mantle.marketing.MarketingPortalServices): Subscribe (the lists
    the site offers, the request and its neutral receipt) and VerifySubscription (a confirmation link's page: what was asked, and
    the Confirm button); P12: SubmitForm (a published survey's form, by its id or an invitation's link, and its neutral receipt). Unsubscribe and preferences are the Account app's Email preferences page. Every page calls the authority
    through pass.Facade.call#Operation only (Marketing/Marketing.js, Shared/Portal.js); no ironstone service or BOSS screen. Plain
    HTML without JavaScript. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Subscriptions">
  <always-actions>
    <set field="passApp" value="marketing"/>
  </always-actions>
  <subscreens default-item="Subscribe"/>
  <widgets>
    <subscreens-active/>
  </widgets>
</screen>
