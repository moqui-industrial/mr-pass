<!-- HeldMail (Dogfood §6.3, D17), at held-mail/<token> under the forum's mount: the page of the link a mailing list
    answers with when a message came from an address that is no account's. Such a message is never posted as it is: it is
    held, its sender gets this link once, and the list's moderators see it waiting in the review queue. The page writes
    nothing: a visitor is asked to sign in or register with that address and comes back; an account posts the message
    with the form (claimHeldMail, which needs the account's confirmed address to be the sender's and passes the forum's
    own post gate). A link that was used or has expired says so. A message is kept for 30 days. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" require-authentication="false" default-menu-include="false">
  <parameter name="token"/>
  <transition name="claim">
    <parameter name="token"/>
    <actions>
      <script><![CDATA[
        const back=String(publicPath || '').replace(/\/claim$/, '')
        if(!ec.user.userId){ec.web.response.sendRedirect((passBases.account ?? '/account')+'/Login?returnTo='+encodeURIComponent(back));return}
        const out=ec.resource.script('component://mr-pass/screen/Shared/Portal.js').attempt('claimHeldMail',{siteId:resolvedSiteId,token:String(token || ''),operationId:ec.web.parameters.operationId || ec.user.randomString(32)},{newTransaction:true})
        if(out.error)ec.web.response.sendRedirect(back+'?refused='+(out.error.kind==='NotFound'?'gone':out.error.kind==='Unauthorized'?'address':'other'))
        else ec.web.response.sendRedirect((passBases.forum || '')+'/t/'+encodeURIComponent(out.result.rootCommEventId)+(out.result.state==='pending'?'?held=review':''))
    ]]></script>
    </actions>
    <default-response type="none"/>
  </transition>
  <actions>
    <script><![CDATA[
        heldRefused=String(ec.web.parameters.refused || '')
        heldPath=String(publicPath || '')
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html"><![CDATA[<h1>Your message to the list</h1>
<#if heldRefused == 'gone'><p role="alert" class="error" id="PassHeldGone">This link was used already or has expired. A held message is kept for 30 days; send it again from your account's address.</p></#if>
<#if heldRefused == 'address'><p role="alert" class="error" id="PassHeldAddress">Sign in with the account whose confirmed address sent the message, or confirm that address in your account's settings.</p></#if>
<#if heldRefused == 'other'><p role="alert" class="error" id="PassHeldRefused">The message could not be posted now. Try again later.</p></#if>
<#if !siteInfo.authenticated><p class="card" id="PassHeldSignIn">Your message was not posted, because every post needs an account with a confirmed address. It is kept for you. Sign in with the address you sent it from<#if siteInfo.site.registrationMode == 'open'>, or register with that address,</#if> and come back to this link. <a href="${passBases.account}/Login?returnTo=${encodeURIComponent(heldPath)}">Sign in</a><#if siteInfo.site.registrationMode == 'open'> · <a href="${passBases.account}/Register?returnTo=${encodeURIComponent(heldPath)}">Register</a></#if></p>
<#else><form method="post" id="PassHeldMailClaim" action="${heldPath}/claim"><input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}"><input type="hidden" name="operationId" value="${ec.user.randomString(32)}"><p>Your message is posted to the list as your account. The address you sent it from must be this account's confirmed address.</p><button>Post my message</button></form></#if>]]></text>
    </render-mode>
  </widgets>
</screen>
