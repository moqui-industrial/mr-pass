<!-- Shop: a ProductStore's storefront (design-shop; impl-shop P1), the `shop` app of PublicSiteApp, mounted at /shop or at the
    site's root, its target the store an operator set. Every page reads the trusted context first (getShopContext through
    pass.Facade.call#Operation, Shared/Portal.js): a site not published, a disabled Shop mount or a store no longer
    available answers Not Found, as an unknown page does. With a published theme (P2) Shop's own pages render the active
    release through ShopTheme.js, in its own layout instead of the PASS shell (Pass.xml leaves its header and footer out when
    shopThemed); without one Home keeps the PASS shell. Account, Billing and Support keep the PASS shell with the
    site's brand. The release's assets are under the mount at theme/{manifest digest}/{path} (resolve#Route). P3's catalog
    pages (Home, Categories, CategoryDetail, Search, ProductDetail, Page) render through Shop/Catalog.js. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Shop">
  <always-actions>
    <script><![CDATA[
        passApp='shop'
        const found=ec.resource.script('component://mr-pass/screen/Shared/Portal.js').attempt('getShopContext',{siteId:resolvedSiteId})
        if(found.error){const e=new Error(found.error.message);e.moquiErrorKind=found.error.kind==='NotFound'?'NotFound':'Unavailable';throw e}
        shopContext=found.result
        // a published theme renders Shop's pages as whole documents, so Pass.xml leaves out the PASS shell (P2)
        shopThemed=!!shopContext.release
    ]]></script>
  </always-actions>
  <transition name="themeAsset" method="get" read-only="true">
    <parameter name="themeDigest"/>
    <parameter name="assetPath"/>
    <actions>
      <script>ec.resource.script('component://mr-pass/screen/Shop/ShopTheme.js').sendAsset(shopContext,themeDigest,assetPath)</script>
    </actions>
    <default-response type="none"/>
  </transition>
  <!-- P3: the Shop mount's robots.txt and sitemap.xml (resolve#Route; design-shop §11: only current public pages) -->
  <transition name="robots" method="get" read-only="true">
    <actions>
      <script>ec.resource.script('component://mr-pass/screen/Shop/Catalog.js').robots(shopContext)</script>
    </actions>
    <default-response type="none"/>
  </transition>
  <transition name="sitemap" method="get" read-only="true">
    <actions>
      <script>ec.resource.script('component://mr-pass/screen/Shop/Catalog.js').sitemap(shopContext)</script>
    </actions>
    <default-response type="none"/>
  </transition>
  <!-- Commerce P14: a store feed's active build at the reserved feed path (resolve#Route), checked by the authority against
      the site's current generation (getShopFeed); Shop/ShopFeeds.js -->
  <transition name="feed" method="get" read-only="true">
    <parameter name="feedKey"/>
    <parameter name="feedExtension"/>
    <actions>
      <script>ec.resource.script('component://mr-pass/screen/Shop/ShopFeeds.js').serve(shopContext,String(feedKey || ''),String(feedExtension || ''))</script>
    </actions>
    <default-response type="none"/>
  </transition>
  <!-- P4 (F61): a public product's image, streamed after the authority's check (getShopProductImage); Commerce P9: an approved
      review's image by its digest (getShopReviewImage) -->
  <transition name="media" method="get" read-only="true">
    <parameter name="productContentId"/>
    <parameter name="reviewImage"/>
    <actions>
      <script>if(reviewImage)ec.resource.script('component://mr-pass/service/pass/Facade.js').downloadFile(shopContext.site.siteId,'getShopReviewImage',{reviewImage:String(reviewImage)})
        else ec.resource.script('component://mr-pass/service/pass/Facade.js').downloadFile(shopContext.site.siteId,'getShopProductImage',{productContentId:String(productContentId || '')})</script>
    </actions>
    <default-response type="none"/>
  </transition>
  <subscreens default-item="Home"/>
  <widgets>
    <subscreens-active/>
  </widgets>
</screen>
