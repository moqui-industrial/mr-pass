<!-- A signed-in contact's invoices: those of the customers the contact was invited for (find#Invoices). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Invoices">
  <actions>
    <script><![CDATA[
        const found=siteInfo.authenticated
            ? ec.resource.script('component://mr-pass/screen/Shared/Portal.js').attempt('findInvoices',{siteId:resolvedSiteId})
            : {result:{invoiceList:[]}}
        invoiceList=found.result?.invoiceList || []
        failure=found.error || null
    ]]></script>
  </actions>
  <widgets>
    <render-mode>
      <text type="html" location="component://mr-pass/screen/Billing/Invoices.html.fancy"/>
    </render-mode>
  </widgets>
</screen>
