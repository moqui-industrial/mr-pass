<!-- Supplier: a supplier's pages for the organization the site's supplier mount targets. BillUpload is Accounting's
    (mr-mantle mantle.account.PortalServices); SupplierHome (the landing), QuoteResponse, which an RFQ's link opens with
    its token, and OrderAcknowledgement, which a purchase order's link opens with BillUpload beside it, are Purchasing's
    (mantle.order.SupplierPortalServices, impl-purchasing P16). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="Supplier">
  <always-actions>
    <set field="passApp" value="supplier"/>
  </always-actions>
  <subscreens default-item="SupplierHome"/>
  <widgets>
    <subscreens-active/>
  </widgets>
</screen>
