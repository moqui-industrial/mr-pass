<?xml version="1.0" encoding="UTF-8"?>
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd">
  <default-property name="pass_verification_template" value="PASS_TEST_VERIFY"/>
  <default-property name="pass_client_test_secret" value="test-deployment-secret"/>
  <default-property name="pass_client_test_sites" value="PASS_AUTH,PASS_HTTP,ZIZI_SHOP,ZIZI_DIGITAL"/>
  <default-property name="pass_sender_addresses" value="community@example.test"/>
  <default-property name="pass_mail_template_ids" value="PASS_TEST_NOTICE,PASS_TEST_INBOUND"/>
  <default-property name="pass_sso_flows" value="PASS_TEST_SSO"/>
  <default-property name="pass_client_test_callback" value="https://frontend.example.test/account/Sso"/>
  <default-property name="pass_scanner_service" value="pass.test.MediaServices.scan#File"/>
  <default-property name="pass_media_root" value="runtime://tmp/pass-media"/>
  <default-property name="pass_import_dir" value="runtime://tmp/pass-import"/>
  <default-property name="pass_test_scanner" value="true"/>
  <default-property name="pass_route_domains" value="lists.example.test"/>
  <default-property name="pass_classifier_service" value="pass.test.ClassifierServices.classify#Post"/>
  <!-- Commerce P5 (F54): the BOSS origins that may frame a theme preview (any local port, for the walks) -->
  <default-property name="pass_preview_frame_origins" value="http://localhost:* http://127.0.0.1:*"/>
  <webapp-list>
    <webapp name="webroot">
      <public-site host="127.0.0.1" site-id="PASS_HTTP" screen-location="component://mr-pass/screen/Pass.xml" resolver-service="pass.RouteServices.resolve#Route">
        <mount path="/forum" screen="Forum"/>
        <mount path="/account" screen="Account"/>
        <mount path="/members" screen="Members"/>
        <mount path="/sites" screen="Sites"/>
        <mount path="/billing" screen="Billing"/>
        <mount path="/supplier" screen="Supplier"/>
        <mount path="/support" screen="Support"/>
        <mount path="/shop" screen="Shop"/>
        <mount path="/code" screen="Smithy"/>
      </public-site>
      <!-- Smithy (Dogfood DG1; plan/design-smithy.md §4.1): a site with Smithy at its root, where a repository's page URL is its
          clone address too; a browser reaches *.localhost on this machine -->
      <public-site host="smithy.localhost" site-id="SMITHY_ROOT" screen-location="component://mr-pass/screen/Pass.xml" resolver-service="pass.RouteServices.resolve#Route">
        <mount path="/" screen="Smithy"/>
        <mount path="/forum" screen="Forum"/>
        <mount path="/account" screen="Account"/>
      </public-site>
      <!-- Shop P3's acceptance walks (test/acceptance/ShopFixtures, client/ShopHttp): the demo Shop sites, ZIZI_SHOP with Shop at
          its root, ZIZI_DIGITAL with Shop at /shop; a browser reaches *.localhost on this machine -->
      <public-site host="shop.zizi.localhost" site-id="ZIZI_SHOP" screen-location="component://mr-pass/screen/Pass.xml" resolver-service="pass.RouteServices.resolve#Route">
        <mount path="/" screen="Shop"/>
        <mount path="/account" screen="Account"/>
        <mount path="/billing" screen="Billing"/>
        <mount path="/support" screen="Support"/>
      </public-site>
      <public-site host="digital.zizi.localhost" site-id="ZIZI_DIGITAL" screen-location="component://mr-pass/screen/Pass.xml" resolver-service="pass.RouteServices.resolve#Route">
        <mount path="/shop" screen="Shop"/>
        <mount path="/account" screen="Account"/>
        <mount path="/billing" screen="Billing"/>
        <mount path="/support" screen="Support"/>
      </public-site>
      <!-- Commerce P5 (F54): ZIZI_SHOP's theme preview host, which serves only the preview render (Commerce's ThemeEditor
          frames it; its PublicSiteHost row is PshkPreview); Mantle's host check keeps the framework's routes off it (F87) -->
      <public-site host="preview.shop.zizi.localhost" site-id="ZIZI_SHOP" screen-location="component://mr-pass/screen/Pass.xml" resolver-service="pass.RouteServices.resolve#Route" host-check-service="mantle.public.ThemeServices.get#PreviewHost">
        <mount path="/" screen="Shop"/>
      </public-site>
      <!-- Several sites by host name (docs/Deployment.md; the framework's plans/Edge-Node2.md §4.2, E14): the Forum at the root
          of its own host (SITES_FORUM, test/acceptance/SiteHostsFixtures) and ZIZI_SHOP's Shop at the root of a second host of
          the site. Pass.xml is each host's root screen, with the framework's routes refused there; the public-site binds the
          site. client/SiteHostsHttp walks them. -->
      <root-screen host="forum\.sites\.localhost|shop\.sites\.localhost" location="component://mr-pass/screen/Pass.xml" framework-routes="refuse"/>
      <public-site host="forum.sites.localhost" site-id="SITES_FORUM" screen-location="component://mr-pass/screen/Pass.xml" resolver-service="pass.RouteServices.resolve#Route">
        <mount path="/" screen="Forum"/>
        <mount path="/account" screen="Account"/>
      </public-site>
      <public-site host="shop.sites.localhost" site-id="ZIZI_SHOP" screen-location="component://mr-pass/screen/Pass.xml" resolver-service="pass.RouteServices.resolve#Route">
        <mount path="/" screen="Shop"/>
        <mount path="/account" screen="Account"/>
      </public-site>
    </webapp>
  </webapp-list>
</moqui-conf>
