<article class="store-section product" data-section-id="${section.id}">
  <h1>${product.name}</h1>
  <#if product.image><img src="${product.image.url}" alt="${product.image.alt || product.name}"></#if>
  <#if product.price><p class="price">${product.price.display}<#if product.compareAtPrice> <s>${product.compareAtPrice.display}</s></#if></p></#if>
  <#if product.availability><p class="availability">${product.availability.label}</p></#if>
  <#if product.badge><p class="badge">${product.badge}</p></#if>
  <#if section.settings.showSku && product.sku><p class="sku">${t("product.sku")} ${product.sku}</p></#if>
  <#if product.description><div class="description">${product.description}</div></#if>
  <div class="component">${components["shop.productPurchase"]}</div>
  <#if product.reviews><section class="reviews" aria-label="${t("reviews.heading")}">
    <h2>${t("reviews.heading")}</h2>
    <#if product.reviews.summary.count><p class="review-summary"><strong>${product.reviews.summary.average} ${t("reviews.ofFive")}</strong> · ${product.reviews.summary.count} ${t("reviews.count")}</p><#else><p class="review-summary">${t("reviews.none")}</p></#if>
    <#if product.reviews.own><p class="review-own">${t("reviews.own")} ${product.reviews.own.statusText}</p></#if>
    <#list product.reviews.reviews as review><div class="review">
      <p><strong>${review.rating} ${t("reviews.ofFive")}</strong> · ${review.authorLabel} <small>${review.dateText}<#if review.verifiedPurchase> · ${t("reviews.verified")}</#if></small></p>
      <p>${review.body}</p>
      <#list review.images as photo><img src="${photo.url}" alt="${photo.alt}" loading="lazy" width="160"></#list>
      <#if review.reply><blockquote class="review-reply"><p><strong>${t("reviews.replyFrom")} ${shop.name}</strong> <small>${review.reply.dateText}</small></p><p>${review.reply.text}</p></blockquote></#if>
    </div></#list>
    <#if product.reviews.moreUrl><p><a href="${product.reviews.moreUrl}">${t("reviews.all")}</a></p></#if>
    <#if product.reviews.writeUrl><p><a href="${product.reviews.writeUrl}">${t("reviews.write")}</a></p></#if>
  </section></#if>
</article>
